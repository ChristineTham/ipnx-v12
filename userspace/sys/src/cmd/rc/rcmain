# rcmain: Plan 9 version
if(~ $#home 0) home=/
if(~ $#ifs 0) ifs=' 	
'
switch($#prompt){
case 0
	prompt=('% ' '	')
case 1
	prompt=($prompt '	')
}
if(~ $rcname ?.out) prompt=('broken! ' '	')
if(flag p) path=/bin
if not{
	finit
	if(~ $#path 0) path=(. /bin)
}
fn sigexit
# The shell's configuration is the profiles' (docs/packages.md): the
# system's /profile/shell.env and shell.rc, and then the user's, run by every
# new shell — what is above is only for a shell that finds neither. A fork
# never runs rcmain again, so a subshell does not.
for(f in /profile/shell.env /profile/shell.rc $home/profile/shell.env $home/profile/shell.rc)
	if(/bin/test -r $f) . $f
if(! ~ $#cflag 0){
	if(flag l && /bin/test -r $home/lib/profile) . $home/lib/profile
	status=''
	eval $cflag
}
if not if(flag i){
	if(flag l && /bin/test -r $home/lib/profile) . $home/lib/profile
	status=''
	if(! ~ $#* 0) . $*
	. -i '#d/0'
}
if not if(~ $#* 0) . '#d/0'
if not{
	status=''
	. $*
}
exit $status
