# /namespace — THE INSTANCE'S OWN CONFIGURATION (design.md 2026-09-04).
#
# '/' is a PROJECT instantiated from the '/template/system' template, and this
# is the project's own namespace file — which is why it lives in '/' and not in
# the template. The template is a proto '/', read when a system is INSTANTIATED
# and never again: instantiate once, boot many times. An instantiated '/' may
# be modified and saved back as a new template, and that is only possible
# because boot reads this file rather than the mould it was cast from.
#
# It is the namespace(6) subset, read by init through newns(); the root is
# implicit — an empty namespace resolves absolute paths through the ramfs (#R).
# The format is one format across /profile, /pkg and /template (decision log
# 2026-09-02): a list of bindings plus commands.
bind #c /dev
bind #e /env
bind #d /fd
bind #s /srv
bind #p /proc
# the control interface lives at a path, not at a device letter
# (docs/window.md): #w/<type>/<n> is reached as /dev/window/<type>/<n>.
bind #w /dev/window
