#!/bin/rc
# storeproof — Go and Python AS PACKAGES, run from the store (P2 step 5).
#
# Boot a host that has a store behind '#Z' and run this:
#
#   cargo run --release -p host -- userspace/rootfs --host userspace -i
#   % rc /rc/storeproof
#
# `bash userspace/mk.sh` materialises userspace/store (the store entries and
# their manifests) and userspace/pkg (the declarations). This script assembles
# them the way boot will once step 3's rc script has a name — which is the one
# thing still missing, and the reason this is a proof rather than the boot path.
#
# What it proves: 41MB of Python and 5MB of Go live in HOST STORAGE, are
# verified against one pinned digest each, and run — while the guest's own tree
# never holds them. That is "bind what stays shared" at the scale that made the
# rule necessary (RESEARCH §9.24: 49MB of rootfs against a 16MB guest ceiling).
fails=()

if(! bind '#Z' /n/z >[2]/dev/null){
	echo PASS 'store: no #Z on this host — skipped'
	exit 0
}
if(! test -d /n/z/store){
	echo PASS 'store: no store behind #Z (run mk.sh, boot with --host userspace) — skipped'
	exit 0
}

mkdir -p /store /pkg
bind /n/z/pkg /pkg			# the declarations: the record of what is installed
storefs -s store /n/z/store &		# THE store's server: immutability is IPNX's rule
sleep 2
mount store /store

# 1. the declarations ARE the record, and the audit is five lines for 41MB
pl=`{pkg list}
if(~ $"pl 'go python') echo PASS 'store: the declarations are the record — ls /pkg is pkg list'; if not fails=bad

# 2. one pinned digest per package, covering a manifest that pins every file
pv=`{pkg verify go}
if(~ $"pv *clean*) echo PASS 'store: go verifies against its pinned digest, offline, from the store'; if not fails=bad

# 3. and they RUN from the store — by explicit store path, so no union
#    ambiguity can be mistaken for the proof
bind -b /store/python/3.14/lib /lib
py=`{/store/python/3.14/bin/python -c 'import json,sys; print(json.dumps([sys.version_info.major, sys.version_info.minor]))'}
if(~ $"py '[3, 14]') echo PASS 'store: REAL CPython runs FROM THE STORE — 30MB streamed over 9P, stdlib bound'; if not fails=bad

go=`{/store/go/1.25/bin/gohello}
if(~ $"go *Go*) echo PASS 'store: a REAL Go binary runs FROM THE STORE'; if not fails=bad

# 4. the union makes them ordinary names, which is what installing IS
# the bind's own status is checked: /bin still carries the seed's copies until
# the flip, so a silently failed bind would otherwise look like a pass
bg=`{bind -b /store/go/1.25/bin /bin >[2=1]; echo $status}
bp=`{bind -b /store/python/3.14/bin /bin >[2=1]; echo $status}
gu=`{gohello}
pu=`{python -c 'print("bound")'}
if(~ $"bg '' && ~ $"bp '' && ~ $"gu *Go* && ~ $"pu bound) echo PASS 'store: bound into /bin they are ordinary names — installing is a bind'; if not fails=bad

if(~ $"fails bad) echo STOREPROOF FAILED
if not echo 'storeproof: all checks passed'
