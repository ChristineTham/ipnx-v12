# emcaopen <type> [path] — open a typed window.
#
# THE REGISTRY DOES THE WORK, and what little is left here is deliberately
# little: mint a window of the type, and say which file it is on. Everything
# else — the toolbar, the tag, the placement — belongs to emca, which learns
# of the window from the device and furnishes it (docs/emca.txt PART SIX).
#
# With emca not running this still opens a window: it lands in its type's
# default pane, bare. That is the degrades-correctly property, and it is why
# any program may mint — emca has no privilege.
t=$1
r=/type/$t
if(! test -d $r){
	echo 'emcaopen: no such type: '^$t >[1=2]
	exit notype
}
# the type's namespace, if it declares one
if(test -s $r/ns) eval `{cat $r/ns}
p=$2
if(~ $#p 0) p=`{cat $r/path >[2]/dev/null}
w=`{cat '#w/'^$t^'/clone'}
if(! ~ $#p 0) echo -n $p > '#w/'^$t^'/'^$w^'/content'
echo $w
