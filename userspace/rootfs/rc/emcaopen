# emcaopen <type> [path] — open a typed window.
#
# THE REGISTRY DOES THE WORK. Nothing about a type is known here: the
# namespace, the chrome and the placement all come out of /type/<name>/,
# which is why "adding a manager is adding a file" (docs/emca.txt). Any
# program may do this; emca has no privilege, and none is running.
t=$1
r=/type/$t
if(! test -d $r){
	echo 'emcaopen: no such type: '^$t >[1=2]
	exit notype
}
# the type's namespace, if it declares one
if(test -s $r/ns) eval `{cat $r/ns}
p=$2
if(~ $#p 0) p=`{cat $r/path >[2]/dev/null}
w=`{cat '#w/'^$t^'/clone'}
d='#w/'^$t^'/'^$w
if(! ~ $#p 0) echo -n $p > $d/content
if(test -s $r/window) cat $r/window > $d/toolbar
echo -n $"p^' | ' > $d/tag
echo $w
