# The host half, proved end to end: IPNX declares a window's chrome, the
# HOST renders it and reports a click back, and this script — an ordinary
# guest, no emca anywhere — reads that click out of the window's events.
w=`{cat '#w/pkg/clone'}
echo -n /usr/kitty/notes.txt > '#w/pkg/'^$w/content
echo Install ipnx:Install > '#w/pkg/'^$w/toolbar
echo -n 'pkg | ' > '#w/pkg/'^$w/tag
echo WINPROOF minted $w
e=`{read < '#w/pkg/'^$w^'/events'}
echo WINPROOF got $"e
# the surface streamed the edited file back; read it as any guest would
sleep 1
echo WINPROOF file now: `{cat /usr/kitty/notes.txt}
