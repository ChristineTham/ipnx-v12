# rc acceptance tests: each check is one if(...) line; failures flip $fails.
# Runs in a namespace copy (init rforked with RFNAMEG), so the bind test
# below must not leak into init's view — init verifies that afterwards.
fails=ok
echo rc: up, running tests

if(~ `{echo hello | cat} hello) echo PASS 'pipeline: echo hello | cat'; if not fails=bad
if(~ `{echo a && echo b} 'a b') echo PASS 'lists: && runs both'; if not fails=bad
greeting=hi; if(~ $greeting hi) echo PASS 'variables: x=v and $x'; if not fails=bad
x=()
for(i in 1 2 3) x=($x $i)
if(~ $#x 3 && ~ $x(1)^$x(2)^$x(3) 123) echo PASS 'for loop accumulates a list'; if not fails=bad
if(~ `{echo /bin/c*} */bin/cat* && ~ `{echo /bin/c*} */bin/cp*) echo PASS 'glob: /bin/c*'; if not fails=bad
echo written > /tmp/t1
if(~ `{cat /tmp/t1} written) echo PASS 'redirection > and ramfs write'; if not fails=bad
echo more >> /tmp/t1
if(~ `{wc /tmp/t1} 2' '*) echo PASS 'append >> (wc counts 2 lines)'; if not fails=bad
if(~ `{cat < /lib/alt/motd | wc} 1' '*) echo PASS 'input redirection <'; if not fails=bad
if(~ `{ls /lib} '/lib/alt /lib/font /lib/namespace /lib/pkg /lib/python3.14') echo PASS 'ls reads directories'; if not fails=bad
mkdir /tmp/d; cp /etc/motd /tmp/d/m
if(~ `{wc /tmp/d/m} 1' '*) echo PASS 'mkdir and cp'; if not fails=bad
rm /tmp/d/m /tmp/d
if(~ `{ls /tmp} '/tmp/pytest.py /tmp/t1') echo PASS 'rm removes'; if not fails=bad
echo expect one error next:
cat /nonexistent
if(~ $status '') fails=bad; if not echo PASS 'errors set $status'
bind /lib/alt /etc
if(~ `{cat /etc/motd} the*) echo PASS 'bind is a command; lands in the rc namespace'; if not fails=bad
cd /lib
if(~ `{ls alt} alt/motd) echo PASS 'cd builtin, relative walks'; if not fails=bad
cd /

if(~ `{{echo a; echo b} | wc} 2' '*) echo PASS 'a brace group as a pipeline stage (bare fork)'; if not fails=bad
x=outer; @{x=inner; echo $x > /tmp/sub}
if(~ $x outer && ~ `{cat /tmp/sub} inner) echo PASS 'subshell state is a copy, its work is real'; if not fails=bad
@{exit boom}
if(~ $status boom) echo PASS 'subshell status propagates'; if not fails=bad
mkdir /tmp/xbin; cp /bin/echo /tmp/xbin/hello
bind -a /tmp/xbin /bin
if(~ `{hello union works} 'union works') echo PASS 'union: exec through bind -a'; if not fails=bad
if(~ `{ls /bin} *hello*) echo PASS 'union: directory reads concatenate'; if not fails=bad
bind -ac /tmp/xbin /bin
echo made > /bin/unionfile
if(~ `{cat /tmp/xbin/unionfile} made) echo PASS 'union: create lands in the MCREATE element'; if not fails=bad

if(~ `{echo -n abc | wc} '0 1 3') echo PASS 'the real Plan 9 echo: -n, from 4th-edition source'; if not fails=bad
echo tenth edition payload > /tmp/v10cat
if(~ `{/v10/bin/cat /tmp/v10cat} 'tenth edition payload') echo PASS 'the real V10 cat, from the TUHS tapes, reads the namespace'; if not fails=bad
if(~ `{/v10/bin/echo -n abc | wc} '0 1 3') echo PASS 'the real V10 echo: -n'; if not fails=bad
if(~ `{/v10/bin/echo -e 'a\tb' | wc} '1 2 4') echo PASS 'V10 echo -e escapes — the fingerprint Plan 9 echo lacks'; if not fails=bad
if(~ `{/v10/bin/echo tenth edition | cat} 'tenth edition') echo PASS 'V10 and Plan 9 binaries, one pipeline, side by side'; if not fails=bad

if(~ `{echo hello | sed s/hello/goodbye/} goodbye) echo PASS 'real sed rewrites (libregexp at work)'; if not fails=bad
if(~ `{echo a b c | tr a-c A-C} 'A B C') echo PASS 'real tr maps ranges'; if not fails=bad
if(~ `{{echo b; echo a; echo b} | sort | uniq | wc} 2' '*) echo PASS 'real sort | uniq pipeline'; if not fails=bad
if(~ `{ls /bin | grep '^/bin/grep$'} /bin/grep) echo PASS 'real grep, anchored regexp'; if not fails=bad
if(~ `{date | wc} 1' '*) echo PASS 'real date speaks (nsec, ctime)'; if not fails=bad
if(test -f /etc/motd) echo PASS 'real test -f drives rc conditionals'; if not fails=bad
if(test -d /nonexistent) fails=bad; if not echo PASS 'real test -d says no'

# su: identity transition under the ctl rules — never escalation. The
# eve-ruid shell may become anyone (rule 1); su none is the drop shell.
if(~ `{su none id} 'none none') echo PASS 'su none: the privilege-drop shell (rule 1, both ids move)'; if not fails=bad

# sam — the SUCCESSOR holding the ancestor's own tests (the succession
# rule: sam-today inherited /bin/sam by passing these unchanged):
# structural regexps, and the buffer piped through a real command
echo sam test line > /tmp/samf
echo 'e /tmp/samf
,x/test/ c/TEST/
,| tr a-z A-Z
w /tmp/samf
q' > /tmp/samscript
sam -d < /tmp/samscript > /dev/null >[2] /dev/null
if(~ `{cat /tmp/samf} 'SAM TEST LINE') echo PASS 'sam-today holds the ancestor'^''''^'s test: x, c, and | through real tr'; if not fails=bad

# M4, hostfs ('#Z'): a host directory as files — create, write, read back,
# stat length, remove, all against the real disk. Self-skips where the host
# offers no '#Z' (the frozen oracle, the browser).
hz=`{bind '#Z' /n/hz >[2=1]; echo $status}
if(~ $"hz ''){
	echo persist me > /n/hz/m4file
	hzr=`{cat /n/hz/m4file}
	mkdir /n/hz/m4dir
	hzl=`{ls /n/hz/m4dir}
	rm /n/hz/m4file /n/hz/m4dir
	hzg=`{cat /n/hz/m4file >[2=1]}
	if(~ $"hzr 'persist me' && ~ $"hzl '' && ~ $"hzg *'does not exist'* || ~ $"hzg *o such*) echo PASS 'hostfs: a host directory serves create/write/read/remove'; if not fails=bad
}
if not echo PASS 'hostfs: no #Z on this host — skipped'

# The versioning layer ('#V'): a snapshot is a tree, restore is a bind.
# snap freezes the ram root by structural clone (bytes shared, COW on the
# live side's next write); the past reads back verbatim, binds over the
# present, and refuses every write — even eve's. Self-skips where the
# kernel offers no '#V' (the frozen oracle).
vs=`{bind '#V' /n/vs >[2=1]; echo $status}
if(~ $"vs ''){
	echo -n one > /tmp/vfile
	echo snap t1 > /n/vs/ctl
	echo -n two > /tmp/vfile
	vpast=`{cat /n/vs/t1/tmp/vfile}
	vnow=`{cat /tmp/vfile}
	rm /n/vs/t1/tmp/vfile >[2]/dev/null
	vheld=`{cat /n/vs/t1/tmp/vfile}
	mkdir /tmp/rewind
	bind /n/vs/t1/tmp /tmp/rewind
	vrest=`{cat /tmp/rewind/vfile}
	echo del t1 > /n/vs/ctl
	vgone=`{ls /n/vs}
	if(~ $"vpast one && ~ $"vnow two && ~ $"vheld one && ~ $"vrest one && ~ $"vgone *ctl*) echo PASS 'versioning: snap freezes the tree, bind restores it, history refuses writes'; if not fails=bad
}
if not echo PASS 'versioning: no #V on this host — skipped'

# ar(1): the plain GNU archive without the ranlib table — wasm-ld links
# index-less archives (measured, RESEARCH §9.8), so 'ar r' + 'cc -l' is the
# whole static-library story. Round-trip r/t/x/d, replacement included.
arres=`{@{
	cd /tmp
	echo -n alpha > af
	echo -n beta > bf
	ar r t.a af bf
	art=`{ar t t.a}
	echo -n ALPHA > af
	ar r t.a af
	rm af bf
	ar x t.a
	arx=`{cat af bf}
	ar d t.a af
	ard=`{ar t t.a}
	rm t.a af bf
	if(~ $"art 'af bf' && ~ $"arx ALPHAbeta && ~ $"ard bf) echo arok
}}
if(~ $"arres arok) echo PASS 'ar: archives round-trip r/t/x/d, replacement lands'; if not fails=bad

# run(1): a spec directory instantiates a process — M12's local stage.
# The spec declares a namespace (built on the boot file), an environment,
# a credential and a command; run detaches, declares, drops, execs.
mkdir /tmp/s1
cat /lib/namespace > /tmp/s1/namespace
echo 'bind /lib/alt /n/sx' >> /tmp/s1/namespace
echo 'GREETING=hello' > /tmp/s1/env
echo webster > /tmp/s1/user
echo cat > /tmp/s1/cmd
echo /env/GREETING >> /tmp/s1/cmd
echo /dev/user >> /tmp/s1/cmd
echo /n/sx/motd >> /tmp/s1/cmd
rout=`{run /tmp/s1}
if(~ $"rout hellowebsterthe*private*view*motd) echo PASS 'run: a spec instantiates namespace, env, user and cmd'; if not fails=bad

# svc(4): the control plane is a file server — start scales replicas up,
# a killed replica is restarted (reading status reconciles), scale shrinks,
# stop drains and removes. kubectl is cat and echo.
mkdir /tmp/s2
echo sleep > /tmp/s2/cmd
echo 60 >> /tmp/s2/cmd
svc &
svcpid=$apid
sleep 1
mount svc /n/svc
echo start web /tmp/s2 2 > /n/svc/ctl
st1=`{cat /n/svc/web/status}
kill $st1(6)
sleep 1
st2=`{cat /n/svc/web/status}
svok=no
if(~ $"st2 'want 2 have 2'* && ! ~ $"st2 *' '^$st1(6)^' '* && ! ~ $"st2 *' '^$st1(6)) svok=yes
echo scale web 1 > /n/svc/ctl
st3=`{cat /n/svc/web/status}
echo stop web > /n/svc/ctl
st4=`{ls /n/svc}
if(~ $"st1 'want 2 have 2 pids'* && ~ $svok yes && ~ $"st3 'want 1 have 1'* && ~ $"st4 *ctl) echo PASS 'svc: start scales, a killed replica returns, scale shrinks, stop drains'; if not fails=bad
kill $svcpid

# /dev/canvas (M5 v0, docs/canvas.md): the display is a semantic file
# tree — built, edited and driven entirely from rc, which is the point:
# a UI you can cat, echo and grep. The virtual surface is the suite's
# user; resize and close arrive as protocol lines (the old deferral,
# retired). Self-skips where the window server offers no canvas (the
# frozen oracle; the Rust host until parity lands).
cwid=`{cat '#w/clone'}
cvp='#w/'$"cwid^'/canvas'
cvok=`{cat $cvp/caps >[2=1]}
if(~ $"cvok virtual){
	echo new 1 edit > $cvp/ctl
	echo new 2 path > $cvp/ctl
	echo -n 'hello world' > $cvp/1/data
	echo -n '0,5' > $cvp/1/addr
	echo -n HELLO > $cvp/1/data
	echo -n '0,$' > $cvp/1/addr
	cvd=`{cat $cvp/1/data}
	echo 'viewbox="0 0 10 10"' > $cvp/2/attrs
	echo -n 'M0 0 L10 10' > $cvp/2/data
	cvk=`{cat $cvp/2/kind}
	cva=`{grep viewbox $cvp/2/attrs}
	echo sync > $cvp/ctl
	echo 'event execute 1 0 5 HELLO' > $cvp/ctl
	ev1=`{read < $cvp/events}
	echo resize 320 200 > '#w/'$cwid^'/wctl'
	ev2=`{read < $cvp/events}
	ev3=`{{ echo delete > '#w/'$cwid^'/wctl'; read } < $cvp/events}
	if(~ $"cvd 'HELLO world' && ~ $"cvk path && ~ $"cva *viewbox* && ~ $"ev1 'execute 1 0 5 HELLO' && ~ $"ev2 'resize 0 320 200' && ~ $"ev3 'close 0') echo PASS 'canvas: a UI is files — nodes, addr/data edits, attrs, resize/close as events'; if not fails=bad
}
if not echo PASS 'canvas: no /dev/canvas on this host — skipped'

# /dev/window (docs/window.md): the CONTROL interface — IPNX declares the
# chrome, the surface speaks back, and the window's TYPE IS IN THE PATH.
# The whole point is that this is not emca's: any program mints through
# `#w/<type>/clone`, the DEVICE announces it on the root events file, and
# both halves watch. So emca needs no privilege and a window opens with no
# emca running at all — which is what this test actually proves.
# Self-skips where the window server has no control interface (the frozen
# oracle; the JS supervisor until parity lands).
wtid=`{cat '#w/pkg/clone' >[2]/dev/null}
if(! ~ $"wtid ''){
	wp='#w/pkg/'^$wtid
	# the DEVICE announced the mint — nobody had to be told. The root queue
	# is shared, so skip whatever earlier tests left in it.
	wev=''
	while(! ~ $"wev 'new pkg '*) wev=`{read < '#w/events'}
	# IPNX declares the chrome, one control per line, and ACTIONS NAME A SIDE
	echo 'Install ipnx:Install
Wrap host:toggle-wrap' > $wp/toolbar
	# content is a PATH the host opens over 9P — there is no renderer here
	echo -n /pkg/index > $wp/content
	echo -n 'pkg Install Wrap | ' > $wp/tag
	wtb=`{cat $wp/toolbar}
	wct=`{cat $wp/content}
	wtg=`{cat $wp/tag}
	# the type in the path is validated, not decoration: a wrong type misses
	wbad=`{cat '#w/text/'^$wtid^'/content' >[2]/dev/null}
	# and the same window still answers on its plain number — nothing broke
	wnum=`{cat '#w/'^$wtid^'/content'}
	# CONTENT IS AN EVENT, not a sample: a window is minted before its file is
	# known, so a watcher that read `content` once at mint would race whoever
	# fills it in. The write above therefore announced itself on the same root
	# queue — which is also how the surface reopens a window on another file.
	wcv=''
	while(! ~ $"wcv 'content pkg '*) wcv=`{read < '#w/events'}
	# the surface speaks back; writing events is the virtual surface's door
	echo 'exec Install' > $wp/events
	wu1=`{read < $wp/events}
	wu2=`{{ echo delete > '#w/'$wtid^'/wctl'; read } < '#w/events'}
	if(~ $"wev 'new pkg '^$wtid && ~ $"wcv 'content pkg '^$wtid^' /pkg/index' && ~ $"wtb 'Install ipnx:Install Wrap host:toggle-wrap' && ~ $"wct /pkg/index && ~ $"wtg 'pkg Install Wrap |' && ~ $"wbad '' && ~ $"wnum /pkg/index && ~ $"wu1 'exec Install' && ~ $"wu2 'del '^$wtid) echo PASS '/dev/window: chrome is files — typed path, declared toolbar, lifecycle announced, content announced, surface speaks back'
	if not fails=bad
}
if not echo PASS '/dev/window: no control interface on this host — skipped'

# /type (docs/window.md): the registry BOTH HALVES READ. A window type is a
# directory of small files — ns, optional cmd, window, pane — and nothing about
# a type is known to any program: emcaopen reads the registry, the surface reads
# the registry. This is what "adding a manager is adding a file" means, and the
# test is that a manager APPEARS from files alone, with no manager program.
tyok=`{cat /type/proc/ns >[2]/dev/null}
tycw=`{cat '#w/directory/clone' >[2]/dev/null}
if(! ~ $"tyok '' && ! ~ $"tycw ''){
	# the chrome a type declares, and the namespace it constructs
	typw=`{cat /type/proc/window}
	tynn=`{cat /type/proc/ns}
	# opening through the registry: the caller knows nothing about the type
	tyw=`{rc /rc/emcaopen directory /usr/kitty}
	tyct=`{cat '#w/directory/'^$tyw^'/content'}
	# a type declares only what is EXTRA. The core verbs are emca's, so no
	# type may name one — a type that redeclared Put would make the dirty
	# indicator lie, since Put's presence IS the indicator.
	tycore=`{cat /type/*/window | grep -c '^(Del|Snarf|Get|Look|Edit|Put|Zerox) '}
	# the ns file is APPLIED: proc's bind makes /proc exist for this window
	rc /rc/emcaopen proc /proc >/dev/null >[2=1]
	typroc=`{ls /proc >[2]/dev/null | wc -l}
	# and a type that does not exist is refused, not invented
	tybad=`{rc /rc/emcaopen nosuchtype /x >[2]/dev/null}
	if(~ $"typw 'Kill ipnx:Kill Note ipnx:Note Ns ipnx:Ns' && ~ $"tynn 'bind ''#p'' /proc' && ~ $"tycore 0 && ~ $"tyct /usr/kitty && ! ~ $"typroc 0 && ~ $"tybad '') echo PASS '/type: a manager is files — the registry declares chrome, namespace and placement, and no manager program exists'
	if not fails=bad
}
if not echo PASS '/type: no registry on this host — skipped'

# emca, the IPNX half (implementation.md M14c). A FILE SERVER WITH A WORKSPACE,
# NOT AN EDITOR: no caret, no selection, no line editor — those are the
# surface's. What is tested here is precisely what IPNX owns.
#
# emca has NO PRIVILEGE. It learns of a window from the device, exactly as the
# surface does, and everything below is driven by writing the window's `events`
# file — which is the surface's voice. So this test IS a surface, in rc.
fn kidwait {	# kidwait <windir> <n> — bounded; the tree is emca's now, so
		# a tree verb is a MESSAGE and its effect is not instant
	wdone=no
	for(i in 1 2 3 4 5 6 7 8){
		if(~ $wdone no){
			if(~ `{ls $1/kids >[2]/dev/null | wc -l} $2) wdone=yes
			if(~ $wdone no) sleep 1
		}
	}
}
fn allocwait {	# allocwait <windir> <n> <want> — settle on one kid's alloc bit
	wdone=no
	for(i in 1 2 3 4 5 6 7 8){
		if(~ $wdone no){
			if(~ `{cat $1/kids/$2/alloc >[2]/dev/null} $3) wdone=yes
			if(~ $wdone no) sleep 1
		}
	}
}
# RC HAS NO `return` AND NO `break` (Plan 9 rc's Builtin[] table, plan9.c:40 —
# cd, whatis, eval, exec, exit, shift, wait, ., finit, flag, rfork, and nothing
# else). The old form of these helpers called `return`, which rc looked for as
# /bin/return, did not find, and reported — so EVERY wait ran its full eight
# seconds whether or not the condition had been met, and printed an error each
# time. A flag is the idiom that works.
fn emwait {	# emwait <file> <pattern> — bounded; emca is another process
	wdone=no
	for(i in 1 2 3 4 5 6 7 8){
		if(~ $wdone no){
			if(~ `{cat $1 >[2]/dev/null} $2) wdone=yes
			if(~ $wdone no) sleep 1
		}
	}
}
emok=`{cat '#w/text/clone' >[2]/dev/null}
if(! ~ $"emok ''){
	echo -n hello > /tmp/emca.txt
	# /srv must exist BEFORE emca starts: emca posts its file server there
	# (M17a1). And there is exactly ONE emca for the whole suite — a second
	# one competes for /dev/window/events, which is a QUEUE, so the two
	# would each see half the events and neither would hold the whole set.
	bind '#s' /srv >[2]/dev/null
	emca &
	# THE TREE IS EMCA'S (design.md, 2026-09-03), so the tree is read from
	# emca. One mount, here, and every block below reads /dev/emca/<n>/.
	sleep 1
	for(s in `{ls /srv >[2]/dev/null}) if(~ $s /srv/emca.*) emsrv=$s
	if(! ~ $"emsrv '') mount $emsrv /dev/emca >[2]/dev/null
	emw=`{rc /rc/emcaopen text /tmp/emca.txt}
	emd=/dev/window/text/$emw
	emwait $emd/toolbar '*Revert*'
	# THE TOOLBAR IS THE TYPE'S, and nothing on it is universal — not Save,
	# not Revert, not even Undo, which belongs to `edit` alone because Undo is
	# available exactly where a window's operations stay in a buffer emca
	# holds. The window OPERATIONS are not here at all: their operand is the
	# window as a thing in a layout, so they sit with the controls.
	emtb=`{cat $emd/toolbar}
	# the dynamic block (acme.c:383): Save is absent while the file is clean,
	# and its APPEARANCE is the dirty indicator. acme's Put, era-named.
	emp1=`{grep '^Save' $emd/toolbar | wc -l}
	# the surface reports what it did to its mirror; the buffer is EMCA's
	echo 'insert 0 xy%20' > $emd/events
	emwait $emd/toolbar '*Save*'
	emp2=`{grep '^Save' $emd/toolbar | wc -l}
	# ...and Save writes EMCA'S buffer, not the bytes emca read
	echo 'exec Save' > $emd/events
	emwait /tmp/emca.txt 'xy hello'
	emfile=`{cat /tmp/emca.txt}
	emp3=`{grep '^Save' $emd/toolbar | wc -l}
	# an `ls` window declares NO verbs of its own — Open covers new files and
	# a trailing slash covers new folders, so it needs none
	eml=`{rc /rc/emcaopen directory /usr/kitty}
	emlt=`{cat /dev/window/directory/$eml/toolbar >[2]/dev/null}
	# and Del closes, through the same door the surface uses
	echo 'exec Del' > $emd/events
	emwait $emd/toolbar ''
	emgone=`{cat $emd/toolbar >[2]/dev/null}
	if(~ $"emtb 'Revert ipnx:Revert Undo ipnx:Undo Redo ipnx:Redo' && ~ $"emp1 0 && ~ $"emp2 1 && ~ $"emfile 'xy hello' && ~ $"emp3 0 && ~ $"emlt '' && ~ $"emgone '') echo PASS 'emca: the toolbar is the TYPE''s and nothing on it is universal — Save appears only while dirty and writes emca''s buffer, an ls window declares none at all, and Del closes'
	if not fails=bad
}
if not echo PASS 'emca: no window control interface on this host — skipped'

# M15b — THE TREE (emca.md PART FOUR). A window contains either a body or
# child windows, and `axis` says how it arranges them: row is side by side,
# col is stacked. The tree is WALKABLE — kids/<id> is a directory — so the
# structure IS the filesystem rather than a description of one.
#
# ALTERNATION IS THE INVARIANT: a container's axis is always perpendicular to
# its parent's, which keeps one layout to one tree. The user states a
# DIRECTION and emca works out from the parent's axis whether that means a
# sibling or children — which is the answer to "we may start with a window
# with rows, and then we create a column".
trok=`{cat /dev/window/text/clone >[2]/dev/null}
if(! ~ $"trok ''){
	trd=/dev/window/text/$trok
	tre=/dev/emca/$trok		# THE TREE IS EMCA'S — axis, kids, parent
	tr0=`{cat $tre/axis}			# a window holding a body has no axis
	echo newcol > /dev/window/$trok/events
	kidwait $tre 2
	tr1=`{cat $tre/axis}			# no parent, so it BECOMES a row
	trk=`{ls $tre/kids | sed 's:.*/::'}
	trc=$tre/kids/$trk(1)
	trcax=`{cat $trc/axis}			# and its children are leaves
	# the parent already arranges along row, so newcol ADDS A SIBLING —
	# the child is already a column and gains a neighbour, not an interior
	kwid=`{cat $trc/winid}
	echo newcol > /dev/window/$kwid/events
	kidwait $tre 3
	trk2=`{ls $tre/kids | sed 's:.*/::'}
	trcax2=`{cat $trc/axis}
	# perpendicular to the parent, so newrow GIVES IT CHILDREN
	kwid=`{cat $trc/winid}
	echo newrow > /dev/window/$kwid/events
	kidwait $trc 2
	trcax3=`{cat $trc/axis}
	trg=`{ls $trc/kids | sed 's:.*/::'}
	# CLOSING A CONTAINER CLOSES WHAT IT HOLDS — acme's colcloseall(), and
	# one rule rather than two, because a column is a window. Deleting the
	# root of this subtree must take all six windows with it.
	echo delete > /dev/window/$trok/events
	trgone=`{ls $tre/kids >[2]/dev/null}
	if(~ $"tr0 '' && ~ $"tr1 row && ~ $#trk 2 && ~ $"trcax '' && ~ $#trk2 3 && ~ $"trcax2 '' && ~ $"trcax3 col && ~ $#trg 2 && ~ $#trgone 0) echo PASS 'the tree: kids are walkable, alternation decides — same axis adds a SIBLING, perpendicular gives CHILDREN — and closing a container closes what it holds'
	if not fails=bad
}
if not echo PASS 'the tree: no window control interface on this host — skipped'

# M15c — ALLOCATION. A parent gives rectangles to some of its children; the
# rest appear as TABS. So minimise and maximise are ONE OPERATION with
# different arguments — minimise(me) moves me out of the allocation,
# maximise(me) moves everyone else out — and a tab is a whole window the
# parent has not allocated to, never a reduced one. New tab is the same
# operation again with the allocation bit flipped, which is why it is not a
# fourth concept beside row and column.
alok=`{cat /dev/window/text/clone >[2]/dev/null}
if(! ~ $"alok ''){
	ald=/dev/window/text/$alok
	ale=/dev/emca/$alok		# THE TREE IS EMCA'S
	echo newcol > /dev/window/$alok/events
	kidwait $ald 2
	kw=$ale/kids/0/winid
	kwid=`{cat $kw}
	echo newcol > /dev/window/$kwid/events
	kidwait $ald 3
	# kids are named by POSITION, because order IS the layout and ls sorts —
	# naming them by window id would have hidden the arrangement
	alix=`{ls $ale/kids | sed 's:.*/::'}
	alid=()
	for(i in 0 1 2){ x=`{cat $ale/kids/$i/winid}; alid=($alid $x) }
	al0=`{cat $ale/kids/0/alloc}^' '^`{cat $ale/kids/1/alloc}^' '^`{cat $ale/kids/2/alloc}
	kw=$ale/kids/0/winid
	kwid=`{cat $kw}
	echo maximise > /dev/window/$kwid/events
	allocwait $ald 1 tab
	al1=`{cat $ale/kids/0/alloc}^' '^`{cat $ale/kids/1/alloc}^' '^`{cat $ale/kids/2/alloc}
	kw=$ale/kids/0/winid
	kwid=`{cat $kw}
	echo maximise > /dev/window/$kwid/events
	allocwait $ald 1 allocated
	al2=`{cat $ale/kids/0/alloc}^' '^`{cat $ale/kids/1/alloc}^' '^`{cat $ale/kids/2/alloc}
	kw=$ale/kids/1/winid
	kwid=`{cat $kw}
	echo minimise > /dev/window/$kwid/events
	allocwait $ald 1 tab
	al3=`{cat $ale/kids/1/alloc}
	kw=$ale/kids/1/winid
	kwid=`{cat $kw}
	echo minimise > /dev/window/$kwid/events
	allocwait $ald 1 allocated
	al4=`{cat $ale/kids/1/alloc}
	kw=$ale/kids/0/winid
	kwid=`{cat $kw}
	echo newtab > /dev/window/$kwid/events
	kidwait $ald 4
	al5=`{cat $ale/kids/1/alloc}
	echo delete > /dev/window/$alok/events
	if(~ $"alix '0 1 2' && ~ $"al0 'allocated allocated allocated' && ~ $"al1 'allocated tab tab' && ~ $"al2 'allocated allocated allocated' && ~ $"al3 tab && ~ $"al4 allocated && ~ $"al5 tab) echo PASS 'allocation: minimise and maximise are ONE operation — one moves me out, the other moves everyone else out, both reversible — and New tab is the same again with the allocation bit flipped'
	if not fails=bad
}
if not echo PASS 'allocation: no window control interface on this host — skipped'

# M15c — THE SIZING HEURISTIC. acme's coladd() shrinks the victim to
# min(half its height, THE SPACE ITS CONTENT OCCUPIES) — content-aware, not
# fractional, which is where "automatic and reasonable" comes from. emca
# generalises it: every window declares a MINIMUM and a NATURAL along its
# parent's axis, minimums are met first, the remainder is shared in proportion
# to the SLACK and capped at natural. acme's rule then FALLS OUT rather than
# being ported — a sibling with little content has a lot of slack, a full one
# has none.
#
# This is the strongest assertion in the milestone, and it exists only because
# EMCA OWNS THE GEOMETRY: a test can resize a tree from rc and read the exact
# allocation back.
ftok=`{cat /dev/window/text/clone >[2]/dev/null}
if(! ~ $"ftok ''){
	fw=/dev/window/$ftok
	echo -n one-line > /tmp/fit.small
	cat /rc/tests.rc > /tmp/fit.big
	echo -n /tmp/fit.small > $fw/content
	emwait $fw/toolbar '*Snarf*'
	femca=`{cat $fw/toolbar}
}
if(! ~ $"femca ''){
	fe=/dev/emca/$ftok		# THE TREE IS EMCA'S
	echo 'rect 0 0 1200 800' > $fw/wctl
	echo newrow > /dev/window/$ftok/events
	kidwait $fe 2
	# a child is NAMED through emca's tree and then addressed by id: the
	# kernel has no kids to walk, and content and toolbar are still its
	# files until M17a3 takes the raster
	fk0=`{cat $fe/kids/0/winid}
	fk1=`{cat $fe/kids/1/winid}
	emwait /dev/window/$fk1/toolbar '*Snarf*'
	echo -n /tmp/fit.small > /dev/window/$fk0/content
	echo -n /tmp/fit.big > /dev/window/$fk1/content
	emwait /dev/window/$fk1/content /tmp/fit.big
	sleep 1
	echo fit > $fw/events
	emwait $fe/kids/0/rect '0 0 1200 72'
	f1=`{cat $fe/kids/0/rect}
	f2=`{cat $fe/kids/1/rect}
	# FIT IS IDEMPOTENT — press it twice and nothing moves
	echo fit > $fw/events
	sleep 1
	f3=`{cat $fe/kids/0/rect}
	# a USER RESIZE is an override, honoured until Fit drops it, which is
	# what keeps "resizing is optional and by taste" true
	echo 'resize 1200 300' > /dev/window/$fk0/events
	emwait $fe/kids/0/rect '0 0 1200 300'
	f4=`{cat $fe/kids/0/rect}
	f5=`{cat $fe/kids/1/rect}
	echo fit > $fw/events
	emwait $fe/kids/0/rect '0 0 1200 72'
	f6=`{cat $fe/kids/0/rect}
	echo delete > /dev/window/$ftok/events
	if(~ $"f1 '0 0 1200 72' && ~ $"f2 '0 72 1200 728' && ~ $"f3 $"f1 && ~ $"f4 '0 0 1200 300' && ~ $"f5 '0 300 1200 500' && ~ $"f6 $"f1) echo PASS 'sizing: content-aware after acme'^''''^'s coladd — a 1200x800 column splits 72/728 between a one-line file and a 720-line one; Fit is idempotent; a resize overrides until Fit drops it'
	if not fails=bad
}
if not echo PASS 'sizing: no emca on this host — skipped'

# M15d — THE GEOMETRY CONVERSATION. "Host tells emca - we have a 800x1024
# window. emca says 'Ok, we need to apply this responsive layout' create these
# windows. Host says 'Ok'. emca owns the tree, and the host renders the tree."
#
# The unit is DEVICE-INDEPENDENT PIXELS, with the text cell reported alongside,
# because not every window is text — an image has an aspect ratio and no
# columns at all. The character rule survives as ARITHMETIC, so doubling the
# reader's text size doubles every measure and the breakpoints move for free:
# WCAG 1.4.4 holding by construction rather than by testing.
gtok=`{cat /dev/window/text/clone >[2]/dev/null}
if(! ~ $"gtok ''){
	gw=/dev/window/$gtok
	echo -n one-line > /tmp/geo.small
	cat /rc/tests.rc > /tmp/geo.big
	echo -n /tmp/geo.small > $gw/content
	emwait $gw/toolbar '*Snarf*'
	gemca=`{cat $gw/toolbar}
}
if(! ~ $"gemca ''){
	ge=/dev/emca/$gtok		# THE TREE IS EMCA'S
	echo newrow > /dev/window/$gtok/events
	kidwait $ge 2
	gk0=`{cat $ge/kids/0/winid}
	gk1=`{cat $ge/kids/1/winid}
	emwait /dev/window/$gk1/toolbar '*Snarf*'
	echo -n /tmp/geo.small > /dev/window/$gk0/content
	echo -n /tmp/geo.big > /dev/window/$gk1/content
	emwait /dev/window/$gk1/content /tmp/geo.big
	sleep 1
	# the surface reports its viewport AND its text cell — only the surface
	# knows the cell, since it depends on the rendered font and the reader's
	# text-size setting, both of which are the surface's half
	echo 'resize 1200 800 8 18' > $gw/events
	emwait $ge/kids/0/rect '0 0 1200 72'
	g1=`{cat $ge/kids/0/rect}
	# the SAME viewport with a DOUBLED cell: every measure doubles with it
	echo 'resize 1200 800 16 36' > $gw/events
	emwait $ge/kids/0/rect '0 0 1200 144'
	g2=`{cat $ge/kids/0/rect}
	g3=`{cat $ge/kids/1/rect}
	# and a PICTURE is sized from its header, never from a decode: emca.svg
	# declares viewBox="0 0 240 120", so 120 plus three lines of furniture
	echo 'resize 1200 900 8 18' > $gw/events
	sleep 1
	echo -n /usr/kitty/emca.svg > /dev/window/$gk1/content
	emwait /dev/window/$gk1/content /usr/kitty/emca.svg
	sleep 1
	echo fit > $gw/events
	sleep 1
	g4=`{cat $ge/kids/0/rect}
	# a format emca cannot parse is corrected by the surface, which HAS
	# decoded it — so layout never blocks and emca is never wrong for long
	echo 'size 400 600' > /dev/window/$gk1/events
	emwait $ge/kids/0/rect '0 0 1200 159'
	g5=`{cat $ge/kids/0/rect}
	echo delete > /dev/window/$gtok/events
	if(~ $"g1 '0 0 1200 72' && ~ $"g2 '0 0 1200 144' && ~ $"g3 '0 144 1200 656' && ~ $"g4 '0 0 1200 399' && ~ $"g5 '0 0 1200 159') echo PASS 'geometry: the host reports viewport AND text cell — doubling the cell doubles every measure (72 -> 144), and a picture is sized from its header, corrected by the surface for what emca cannot parse'
	if not fails=bad
}
if not echo PASS 'geometry: no emca on this host — skipped'

# M15e — THE ROOT WINDOW AND ITS CONVENTION. The root is THE SCREEN: the window
# with no parent, and it divides ITSELF. What it divides into is a CONVENTION it
# follows, not a structure the system knows about — nothing downstream can tell
# these columns from any others, because there is no pane type and no reserved
# name. `leaves = cols / 72` decides how many, from the REPORTED cell.
rtok=`{cat /dev/window/root/clone >[2]/dev/null}
if(! ~ $"rtok ''){
	rd=/dev/window/$rtok
	echo -n /etc/motd > $rd/content
	emwait $rd/toolbar '*Save All*'
	remca=`{cat $rd/toolbar}
}
if(! ~ $"remca ''){
	re=/dev/emca/$rtok		# THE TREE IS EMCA'S
	echo 'resize 400 800 8 18' > $rd/events
	sleep 1
	rk1=`{ls $re/kids | sed 's:.*/::'}
	ra1=`{cat $re/axis}
	echo 'resize 1800 800 8 18' > $rd/events
	sleep 1
	rk2=`{ls $re/kids | sed 's:.*/::'}
	rw2=`{cat $re/kids/0/rect}
	# a window living in the last column must SURVIVE the column going away
	echo 'reparent '^$rtok^' 0' > /dev/window/$rtok/events
	rv=`{cat /dev/window/text/clone >[2]/dev/null}
	rpar=`{cat $re/kids/2/winid}
	echo 'reparent '^$rpar > /dev/window/$rv/events
	echo -n /etc/motd > /dev/window/$rv/content
	sleep 1
	echo 'resize 1200 800 8 18' > $rd/events
	sleep 1
	rk3=`{ls $re/kids | sed 's:.*/::'}
	rsurv=`{cat /dev/emca/$rv/parent}
	# closing a column leaves a valid tree; Reset brings it back
	rdel=`{cat $re/kids/1/winid}
	echo delete > /dev/window/$rdel/events
	sleep 1
	rk4=`{ls $re/kids | sed 's:.*/::'}
	echo reset > $rd/events
	emwait $re/axis row
	sleep 1
	rk5=`{ls $re/kids | sed 's:.*/::'}
	echo delete > /dev/window/$rtok/events
	if(~ $"ra1 col && ~ $#rk1 0 && ~ $#rk2 3 && ~ $"rw2 '0 0 600 800' && ~ $#rk3 2 && ! ~ $"rsurv '' && ~ $#rk4 1 && ~ $#rk5 2) echo PASS 'the root window: it divides ITSELF by convention — one column at small, three at large — a shrink hoists windows out of the columns it removes rather than losing them, closing a column leaves a valid tree, and Reset rebuilds'
	if not fails=bad
}
if not echo PASS 'the root window: no emca on this host — skipped'


# proc(3)'s args file: the data was always in the proc record and nothing could
# read it, so nothing could NAME a running command — which the status line's
# "running commands with tap-to-kill" needs (emca.md).
sleep 4 &
pgargs=`{cat /proc/$apid/args >[2]/dev/null}
if(! ~ $"pgargs ''){
	if(~ $"pgargs 'sleep 4') echo PASS '/proc/<pid>/args: a running command can be named, not just numbered'
	if not fails=bad
}
if not echo PASS '/proc/<pid>/args: no args file on this host — skipped'

# /proc/<pid> was walkable but not LISTABLE, so a process manager saw an empty
# directory. Fixed in the Rust core; self-skips on the frozen oracle, which
# still answers empty (the floor is what matters, not parity here).
pidls=`{ls /proc/1 >[2]/dev/null}
if(! ~ $"pidls ''){
	if(~ $"pidls '/proc/1/args /proc/1/ctl /proc/1/note /proc/1/notepg /proc/1/status') echo PASS '/proc/<pid>: the per-pid directory lists its files, not just walks them'
	if not fails=bad
}
if not echo PASS '/proc/<pid>: not listable on this host — skipped'

# console-today (M5, docs/userland.md): the console is an editable
# console-today — one edit node, a mark separating history from input,
# Enter sends the line. con(1) mediates on the wasm libthread; the test
# drives it through the virtual surface's event door and proves the
# full loop with output the typed text never contained. AND, not XOR:
# the xterm byte console stays beside this one.
cnwid=`{cat '#w/clone' >[2]/dev/null}
if(~ $#cnwid 1){
	cnp='#w/'$"cnwid^'/canvas'
	cnok=`{cat $cnp/caps >[2=1]}
}
if not cnok=absent
if(~ $"cnok virtual){
	con -W $cnwid rc -i &
	sleep 3
	echo -n '0,$' > $cnp/1/addr
	cnoff=`{cat $cnp/1/data | wc -c}
	cnpr=`{cat $cnp/1/data}
	echo 'event insert 1 '$cnoff' echo%20-n%20abc;%20echo%20def%0A' > $cnp/ctl
	sleep 2
	echo -n '0,$' > $cnp/1/addr
	cnt=`{cat $cnp/1/data}
	echo 'event close 0' > $cnp/ctl
	# the round trip is the invariant; the prompt's exact bytes under a
	# pipe are rc's tty-world cosmetics and differ by host
	if(! ~ $"cnoff 0 && ~ $"cnt *abcdef*) echo PASS 'console-today: the console is one editable window — line in, output back through one edit node'; if not fails=bad
}
if not echo PASS 'console-today: no canvas on this host — skipped'

# acme — acme-today under the inherited name (the succession rule:
# the behaviour suite is the proof; the raster ancestor's substrate
# tests stay with acme9). The paper's shape: a root tag over a ROW of
# columns, every tag one EDITABLE node whose WORDS execute (the tag's
# first word is the file name — Put writes to it; Edit takes the rest of
# its line as sam's command). Window 0: wrapper 10, tag 11, body 12;
# column 0's tag is 201; the root tag is 1. Executes carry the word.
if(~ $"cnok virtual){
	echo -n 'first draft' > /tmp/ed1
	edwid=`{cat '#w/clone'}
	edp='#w/'$"edwid^'/canvas'
	acme -W $edwid /tmp/ed1 &
	sleep 2
	echo -n '0,$' > $edp/12/addr
	edb=`{cat $edp/12/data}
	echo 'event insert 12 11 %20revised' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	edf=`{cat /tmp/ed1}
	# Edit takes the scratch after the bar: append the command (99 clamps
	# to the tag's end), execute the word
	echo 'event insert 11 99 %20,x/[a-z]+ised/c/POLISHED/' > $edp/ctl
	echo 'event execute 11 0 0 Edit' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	ede=`{cat /tmp/ed1}
	# the tag is editable everywhere: rename its first word, Put follows
	echo 'event delete 11 0 8' > $edp/ctl
	echo 'event insert 11 0 /tmp/ed2' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	edh=`{cat /tmp/ed2}
	# acme's browser: look resolves against the window's directory —
	# a bare name opens the sibling file; an absolute path opens a
	# LISTING window (names, dirs marked /), Del closes it
	echo 'event look 12 0 0 ed1' > $edp/ctl
	sleep 1
	echo -n '0,$' > $edp/22/addr
	edl=`{cat $edp/22/data}
	echo 'event execute 21 0 0 Del' > $edp/ctl
	echo 'event look 11 0 0 /tmp' > $edp/ctl
	sleep 1
	echo -n '0,$' > $edp/22/addr
	edd=`{cat $edp/22/data}
	echo 'event execute 21 0 0 Del' > $edp/ctl
	# a second column, a window born into it (the active-column rule)
	echo 'event execute 1 0 0 Newcol' > $edp/ctl
	echo 'event execute 211 0 0 New' > $edp/ctl
	sleep 1
	edn=`{cat $edp/21/kind >[2=1]}
	echo 'event execute 11 0 0 Del' > $edp/ctl
	sleep 1
	edg=`{cat $edp/12/kind >[2=1]}
	echo 'event close 0' > $edp/ctl
	if(~ $"edb 'first draft' && ~ $"edf 'first draft revised' && ~ $"ede 'first draft POLISHED' && ~ $"edh 'first draft POLISHED' && ~ $"edl 'first draft POLISHED' && ~ $"edd *ed1* && ~ $"edd *ed2* && ~ $"edn edit && ~ $"edg *'does not exist'* || ~ $"edg *o such*) echo PASS 'acme: the heir holds the behaviour suite — columns, editable tags, words execute, look is the browser'; if not fails=bad
}
if not echo PASS 'acme: no canvas on this host — skipped'

# acme against the paper (the fidelity pass, 2026-08-30): external
# commands run in the window's directory, output to dir/+Errors; the
# selection filters | < > work; Undo/Redo unwind by sequence; the tag
# grows Undo/Put dynamically (the paper's rule); B3 takes addresses
# (file:2); Cut/Snarf/Paste are words AND /dev/snarf; Sort orders a
# column; and the file interface serves index, new and
# N/{tag,body,addr,data,ctl,event} at /srv/acme. Window k: 9P dir
# 10+10k, canvas tag 11+10k, body 12+10k.
if(~ $"cnok virtual){
	mkdir /tmp/aw
	echo -n 'alpha beta' > /tmp/aw/f1
	echo one > /tmp/aw/f3
	echo two words here >> /tmp/aw/f3
	echo three >> /tmp/aw/f3
	apwid=`{cat '#w/clone'}
	app='#w/'$"apwid^'/canvas'
	acme -W $apwid /tmp/aw/f1 &
	sleep 2
	# external commands: output lands in /tmp/aw/+Errors (window 1)
	echo 'event execute 11 0 0 echo%20paper%20works' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/22/addr
	er1=`{cat $app/22/data}
	# directory context: a relative name resolves in the window's dir
	echo 'event execute 11 0 0 cat%20f1' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/22/addr
	er2=`{cat $app/22/data}
	# | filters the selection through a command
	echo 'event select 12 0 5' > $app/ctl
	echo 'event execute 11 0 0 |tr%20a-z%20A-Z' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/12/addr
	ab1=`{cat $app/12/data}
	# Undo unwinds it, Redo restores it, the tag says so
	echo 'event execute 11 0 0 Undo' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	ab2=`{cat $app/12/data}
	echo 'event execute 11 0 0 Redo' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	ab3=`{cat $app/12/data}
	echo -n '0,$' > $app/11/addr
	tg1=`{cat $app/11/data}
	# Snarf/Cut/Paste as words, through /dev/snarf itself
	echo 'event select 12 0 5' > $app/ctl
	echo 'event execute 11 0 0 Snarf' > $app/ctl
	sleep 1
	sn=`{cat '#w/snarf'}
	echo 'event execute 11 0 0 Cut' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	cb1=`{cat $app/12/data}
	echo 'event execute 11 0 0 Paste' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	pa1=`{cat $app/12/data}
	# B3 with an address: f3:2 opens the file AT line two (sel travels)
	echo 'event look 12 0 0 f3:2' > $app/ctl
	sleep 1
	a32=`{grep sel $app/32/attrs}
	# the file interface: index, addressed edits, new/, the event file
	mkdir /mnt/acme
	mount acme /mnt/acme
	ix=`{grep -c f1 /mnt/acme/index}
	echo -n 2 > /mnt/acme/30/addr
	echo -n 'TWO WORDS' > /mnt/acme/30/data
	sleep 1
	echo -n '0,$' > $app/32/addr
	w3=`{cat $app/32/data}
	echo hello new > /mnt/acme/new/body
	sleep 1
	echo -n '0,$' > $app/42/addr
	nb=`{cat $app/42/data}
	read < /mnt/acme/10/event > /tmp/aw/ev &
	sleep 1
	echo 'event execute 11 0 0 Put' > $app/ctl
	sleep 2
	ev=`{cat /tmp/aw/ev}
	echo 'event execute 11 0 0 Put' > $app/ctl
	sleep 1
	pf=`{cat /tmp/aw/f1}
	# Sort orders the column's windows by name
	echo 'event execute 201 0 0 Sort' > $app/ctl
	sleep 1
	so1=`{grep order $app/10/attrs}
	unmount /mnt/acme >[2] /dev/null
	echo 'event close 0' > $app/ctl
	apok=yes
	if(! ~ $"er1 'paper works') apok=no
	if(! ~ $"er2 *'alpha beta'*) apok=no
	if(! ~ $"ab1 'ALPHA beta' || ! ~ $"ab2 'alpha beta' || ! ~ $"ab3 'ALPHA beta') apok=no
	if(! ~ $"tg1 *Undo* || ! ~ $"tg1 *Put*) apok=no
	if(! ~ $"sn ALPHA || ! ~ $"cb1 beta || ! ~ $"pa1 'ALPHA beta') apok=no
	if(! ~ $"a32 'sel=4,19') apok=no
	if(~ $ix 0) apok=no
	if(! ~ $"w3 *'TWO WORDS'*) apok=no
	if(! ~ $"nb 'hello new') apok=no
	if(! ~ $"ev 'Mx0 0 0 3 Put') apok=no
	if(! ~ $"pf 'ALPHA beta') apok=no
	if(! ~ $"so1 'order=3') apok=no
	if(~ $apok yes) echo PASS 'acme against the paper: +Errors, the | filter, Undo/Redo, dynamic Put, look addresses, Cut/Snarf/Paste, Sort, and the served file interface'; if not fails=bad
}
if not echo PASS 'acme paper pass: no canvas on this host — skipped'

# rio-today's proof: a window manager in rc. ls '#w' lists the windows;
# /rc/tile writes move and resize lines to every wctl — policy is a file
# you write, so any program can be a window manager, this script included.
# Self-skips where '#w' has no root listing (the frozen oracle).
twl=`{ls '#w' >[2]/dev/null}
if(! ~ $#twl 0){
	tw1=`{cat '#w/clone'}
	tw2=`{cat '#w/clone'}
	rc /rc/tile
	tg1=`{cat '#w/'$tw1^'/wctl'}
	tg2=`{cat '#w/'$tw2^'/wctl'}
	if(~ $tg1(2) 60 && ~ $tg2(2) 60 && ~ $tg1(3) 300 && ~ $tg2(3) 300 && ! ~ $tg1(1) $tg2(1)) echo PASS 'rio-today: a window manager in rc — tile moved every window by writing wctl'; if not fails=bad
	echo delete > '#w/'$tw1^'/wctl'
	echo delete > '#w/'$tw2^'/wctl'
}
if not echo PASS 'rio-today: no #w listing on this host — skipped'

# /dev/snarf: the clipboard is a file (the input convention's own words —
# chords die into the host clipboard via /dev/snarf). On macOS it IS the
# pasteboard (pbcopy/pbpaste); elsewhere the kernel buffer serves. The
# gesture mirror (cmd-C/X/V feeding this file) is the presenter's half.
# Self-skips where '#w' has no snarf (the frozen oracle).
snp=`{cat '#w/snarf' >[2=1]}
if(! ~ $"snp *'does not exist'* && ! ~ $"snp *'bad path'*){
	echo -n 'snarf travels' > '#w/snarf'
	snr=`{cat '#w/snarf'}
	if(~ $"snr 'snarf travels') echo PASS 'snarf: the clipboard is a file — write it, read it back'; if not fails=bad
}
if not echo PASS 'snarf: no /dev/snarf on this host — skipped'

# M2, the namespace-file boot: the same file format that boots the system
# reshapes a world at runtime — newns(file, cmd) clears and rebuilds from
# TEXT, so editing the file rebinds with no recompile (the acceptance).
echo 'bind /lib/alt /etc' > /tmp/ns1
nsa=`{newns /tmp/ns1 cat /etc/motd}
echo 'cd /lib' >> /tmp/ns1
nsb=`{newns /tmp/ns1 pwd}
if(~ $"nsa *'private view'* && ~ $nsb /lib) echo PASS 'newns: a namespace built from a file; an edit rebinds, no recompile'; if not fails=bad

# pkg(1): the whole life of a package against an offline local registry —
# a registry is just a tree of files, so the suite authors one, installs
# from it (streamed, sha256-verified), runs the bound binary through the
# /bin union, verifies digests, and removes. Network never involved.
mkdir /tmp/reg
cp /bin/echo /tmp/reg/pecho.wasm
pd=`{sha256sum < /tmp/reg/pecho.wasm}
echo pecho 1.0 bin /tmp/reg/pecho.wasm $pd > /tmp/reg/index
pkg -r /tmp/reg install pecho > /dev/null
pkv=`{pkg verify pecho}
pkr=`{pecho pkg bound and running}
pkg remove pecho > /dev/null
if(~ $pkr 'pkg bound and running' && ~ $"pkv *clean*) echo PASS 'pkg: install from a registry tree, sha256-verified, bind, verify, remove'; if not fails=bad

# the namespace dissolves package conflicts (design 2026-08-29): a name that
# already resolves to DIFFERENT bytes refuses the install; nothing global to
# corrupt, nothing silently shadowed by accident
mkdir /tmp/reg2
cp /bin/cat /tmp/reg2/echo.wasm
cd2=`{sha256sum < /tmp/reg2/echo.wasm}
echo echo 9.9 bin /tmp/reg2/echo.wasm $cd2 > /tmp/reg2/index
pkc=`{pkg -r /tmp/reg2 install echo >[2=1]}
if(~ $"pkc *CONFLICT* && ~ `{pkg list} '') echo PASS 'pkg: same name, different bytes — the install is refused'; if not fails=bad

# dev environments are processes (design 2026-08-29): an rfork n subshell
# installs its own package; the parent never sees it — venv with no venv
penv=`{rc -c 'rfork n; pkg -r /tmp/reg install pecho > /dev/null; pecho env-private'}
pgone=`{pecho after >[2=1]}
if(~ $penv 'env-private' && ~ $"pgone *'does not exist'*) echo PASS 'pkg in rfork n: a private dev environment, gone with the process'; if not fails=bad

# regexp CLASSES WITH RANGES in x: the class-range sentinel is Runemax
# stored in a Rune (sam/regexp.c bldcclass), so this is the one structural
# pattern that catches a Rune narrower than libc.h's 21-bit era — a 16-bit
# Rune truncates the sentinel and every [a-z] silently stops matching
# (measured 2026-08-29; fixed by u.h's 32-bit Rune, RESEARCH §9.4)
echo 'horses for courses' > /tmp/samr
echo 'e /tmp/samr
,x/[a-z]+es/ g/co/ c/COURSES/
w /tmp/samr
q' > /tmp/samrscript
sam -d < /tmp/samrscript > /dev/null >[2] /dev/null
if(~ `{cat /tmp/samr} 'horses for COURSES') echo PASS 'sam x with class ranges: ,x/[a-z]+es/ g// c// lands'; if not fails=bad

# real-rc capabilities the mini shell refused outright
fn twice {echo $1 $1}
if(~ `{twice hey} 'hey hey') echo PASS 'fn: functions define and take arguments'; if not fails=bad
n=()
while(! ~ $#n 3) n=($n x)
if(~ $#n 3) echo PASS 'while: loops until the condition holds'; if not fails=bad
switch(two){
case one
	fails=bad
case two
	echo PASS 'switch/case selects the matching arm'
case *
	fails=bad
}

# the tour (the public demo's guided walk) runs non-interactively and
# self-skips if the rootfs lacks it — one rootfs serves every host
if(test -f /rc/tour){
	rc /rc/tour > /tmp/tour.out >[2] /dev/null
	if(~ `{grep -c '^tour: complete' /tmp/tour.out} 1 && ~ `{grep -c '^result: horses for COURSES' /tmp/tour.out} 1) echo PASS 'the tour runs end to end, sam edit verified (rc /rc/tour)'; if not fails=bad
}

# M17c — the MIME-shaped registry (docs/type.md). Self-skips if the
# rootfs predates it, so one rootfs still serves the frozen oracle.
if(test -d /type/text/plain){
	tok=ok
	# every type carries the three files the syntax defines
	for(ty in text/plain inode/directory inode/system){
		for(fl in recognise managers verbs)
			if(! test -f /type/^$ty^/^$fl) tok=bad
	}
	# text/plain is the FALLBACK — it claims what nothing else did, so
	# its rule is exactly that and it can never fail
	if(! ~ `{grep -v '^#' /type/text/plain/recognise | grep .} fallback) tok=bad
	# a directory is recognised by the QID, free and certain, with
	# nothing read; `/` by its exact PATH
	if(! ~ `{grep -v '^#' /type/inode/directory/recognise | grep .} 'qid dir') tok=bad
	if(! ~ `{grep -v '^#' /type/inode/system/recognise | grep .} 'path /') tok=bad
	# inode/system SPECIALISES inode/directory: it offers the listing's
	# roles by inheritance and ADDS manage
	if(! grep -s '^manage$' /type/inode/system/managers) tok=bad
	if(grep -s '^manage$' /type/inode/directory/managers) tok=bad
	# the system's verbs are the system's — Halt, Reboot, New Shell
	if(! ~ `{grep -c 'Halt|Reboot|New Shell' /type/inode/system/verbs} 3) tok=bad
	# Save is NOT declared: emca emits it while dirty, because its
	# appearance IS the dirty indicator
	if(grep -s '^Save' /type/text/plain/verbs) tok=bad
	if(~ $tok ok) echo PASS 'M17c: the registry is MIME-shaped — text/plain falls back, a directory is known by its qid and / by its path, inode/system adds manage, and Save is declared nowhere'
	if not fails=bad
}

# M17c — the layout declares the demo's shape: paths only, indentation
# nests, `tabs` the one keyword
if(test -f /type/inode/system/layout){
	lok=ok
	l=`{grep -v '^#' /type/inode/system/layout | grep .}
	# every line is a path or the one keyword
	if(! ~ `{grep -v '^#' /type/inode/system/layout | grep . | grep -c '^[ 	]*(/|tabs)'} 6) lok=bad
	# the three editors are grouped as tabs, and rc is not
	if(! grep -s '^tabs$' /type/inode/system/layout) lok=bad
	if(! grep -s '^/bin/rc' /type/inode/system/layout) lok=bad
	# a shell needs no special case: manage on an executable runs it
	if(! ~ `{grep -c '^/bin/rc[ 	]+manage' /type/inode/system/layout} 1) lok=bad
	if(~ $lok ok) echo PASS 'M17c: the layout is paths and one keyword — the demo shape comes from a file, and a shell window is manage on an executable'
	if not fails=bad
}

# ── M17a1 — EMCA IS A FILE SERVER ──────────────────────────────────────────
# docs/window.md: "The manager interface is a file interface. emca serves one
# directory per window, and a manager reads and writes files in it." Until now
# emca was a CLIENT of the kernel's window device; the window manager owning
# windows means the window manager SERVES them.
#
# What this pins is the contract's ten files, answered out of emca's own state
# — and, crucially, that THE RECTANGLE EMCA SERVES IS THE ONE THE KERNEL HOLDS.
# That equality is what makes M17a2 (the tree moving) a deletion rather than a
# rewrite: two answers agree today, so one of them can go.
sok=ok
# emca's door is INSTANCE-QUALIFIED — /srv/emca.<user>.<pid>, acme's own
# convention (acme.c:321) — because `#s` is one table for the whole kernel
# while every other name a process sees is namespace-local. So the name is
# DISCOVERED, never assumed: a test that hardcoded it would be asserting the
# collision back into existence.
# ONE MOUNT, made where emca starts. A second mount of the same posted channel
# is a second Tversion on a connection srv(3) SHARES — the protocol says that
# resets it, and emca's server keeps one fid table, so two clients on one
# channel is not a thing it can serve. The suite therefore mounts once.
if(! ~ $"emsrv ''){
	echo -n hello > /tmp/srv.txt
	sw=`{rc /rc/emcaopen text /tmp/srv.txt}
	emwait /dev/emca/$sw/title /tmp/srv.txt

	# the ten contract files, plus the five the TREE adds now that the tree
	# is emca's — parent, axis, alloc, winid, kids. A manager's own
	# /dev/window/ gains none of them; this is the TOOL view.
	snf=`{ls /dev/emca/$sw | wc -l}

	# emca answers these itself: nothing here is fetched from the kernel
	sty=`{cat /dev/emca/$sw/type}
	sro=`{cat /dev/emca/$sw/role}
	sti=`{cat /dev/emca/$sw/title}

	# ...and a manager WRITES what it reports, per the contract's other half
	echo '3 matches' > /dev/emca/$sw/status
	sst=`{cat /dev/emca/$sw/status}
	echo 1 > /dev/emca/$sw/dirty
	sdy=`{cat /dev/emca/$sw/dirty}

	# THE EQUALITY THAT GATES M17a2: emca DECIDED this rectangle, so emca
	# can answer for it — and the kernel's copy says the same thing.
	#
	# Note which path drives it. A `rect` written straight to the kernel's
	# wctl is the surface talking PAST emca, and emca never learns; a
	# `resize` on the window's events is the surface talking TO emca, which
	# decides and then tells the kernel. The second is the contract's
	# direction, and the first is precisely the coupling M17a2 removes.
	echo 'resize 900 600' > /dev/window/$sw/events
	emwait /dev/emca/$sw/rect '0 0 900 600'
	srect=`{cat /dev/emca/$sw/rect}
	skrect=`{cat /dev/window/$sw/wctl}

	if(! ~ $"sty text) sok=bad
	if(! ~ $"sro look) sok=bad
	if(! ~ $"sti /tmp/srv.txt) sok=bad
	if(! ~ $"sst '3 matches') sok=bad
	if(! ~ $"sdy 1) sok=bad
	if(! ~ $"snf 15) sok=bad
	if(! ~ $"srect '0 0 900 600') sok=bad
	# the name carries user AND pid, so a nested emca cannot collide
	if(! ~ $"emsrv /srv/emca.*.*) sok=bad
	if(! ~ $"skrect '0 0 900 600 '*) sok=bad
	if(~ $sok ok) echo PASS 'M17a1: emca SERVES its windows — ten contract files per window over 9P at an instance-qualified door, type/role/title from emca''s own state, status and dirty written back, and the rectangle emca serves is the one the kernel holds'
	if not fails=bad
}
if not echo PASS 'M17a1: no emca posted on this host — file server skipped'

if(~ $fails ok) echo rc: tests done
if not echo rc: TESTS FAILED
if(~ $fails ok) exit ''
exit failed
