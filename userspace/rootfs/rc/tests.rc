# rc acceptance tests: each check is one if(...) line; failures flip $fails.
# Runs in a namespace copy (init rforked with RFNAMEG), so the bind test
# below must not leak into init's view — init verifies that afterwards.
fails=ok
echo rc: up, running tests

if(~ `{echo hello | cat} hello) echo PASS 'pipeline: echo hello | cat'; if not fails=bad
if(~ `{echo a && echo b} 'a b') echo PASS 'lists: && runs both'; if not fails=bad
greeting=hi; if(~ $greeting hi) echo PASS 'variables: x=v and $x'; if not fails=bad
x=()
for(i in 1 2 3) x=($x $i)
if(~ $#x 3 && ~ $x(1)^$x(2)^$x(3) 123) echo PASS 'for loop accumulates a list'; if not fails=bad
if(~ `{echo /bin/c*} */bin/cat* && ~ `{echo /bin/c*} */bin/cp*) echo PASS 'glob: /bin/c*'; if not fails=bad
echo written > /tmp/t1
if(~ `{cat /tmp/t1} written) echo PASS 'redirection > and ramfs write'; if not fails=bad
echo more >> /tmp/t1
if(~ `{wc /tmp/t1} 2' '*) echo PASS 'append >> (wc counts 2 lines)'; if not fails=bad
if(~ `{cat < /etc/motd | wc} 1' '*) echo PASS 'input redirection <'; if not fails=bad
if(~ `{ls /lib} '/lib/alt /lib/font /lib/namespace /lib/pkg /lib/python3.14') echo PASS 'ls reads directories'; if not fails=bad
mkdir /tmp/d; cp /etc/motd /tmp/d/m
if(~ `{wc /tmp/d/m} 1' '*) echo PASS 'mkdir and cp'; if not fails=bad
rm /tmp/d/m /tmp/d
if(~ `{ls /tmp} '/tmp/pytest.py /tmp/t1') echo PASS 'rm removes'; if not fails=bad
echo expect one error next:
cat /nonexistent
if(~ $status '') fails=bad; if not echo PASS 'errors set $status'
bind /lib/alt /etc
if(~ `{cat /etc/motd} the*) echo PASS 'bind is a command; lands in the rc namespace'; if not fails=bad
cd /lib
if(~ `{ls alt} alt/motd) echo PASS 'cd builtin, relative walks'; if not fails=bad
cd /

if(~ `{{echo a; echo b} | wc} 2' '*) echo PASS 'a brace group as a pipeline stage (bare fork)'; if not fails=bad
x=outer; @{x=inner; echo $x > /tmp/sub}
if(~ $x outer && ~ `{cat /tmp/sub} inner) echo PASS 'subshell state is a copy, its work is real'; if not fails=bad
@{exit boom}
if(~ $status boom) echo PASS 'subshell status propagates'; if not fails=bad
mkdir /tmp/xbin; cp /bin/echo /tmp/xbin/hello
bind -a /tmp/xbin /bin
if(~ `{hello union works} 'union works') echo PASS 'union: exec through bind -a'; if not fails=bad
if(~ `{ls /bin} *hello*) echo PASS 'union: directory reads concatenate'; if not fails=bad
bind -ac /tmp/xbin /bin
echo made > /bin/unionfile
if(~ `{cat /tmp/xbin/unionfile} made) echo PASS 'union: create lands in the MCREATE element'; if not fails=bad

if(~ `{echo -n abc | wc} '0 1 3') echo PASS 'the real Plan 9 echo: -n, from 4th-edition source'; if not fails=bad
echo tenth edition payload > /tmp/v10cat
if(~ `{/v10/bin/cat /tmp/v10cat} 'tenth edition payload') echo PASS 'the real V10 cat, from the TUHS tapes, reads the namespace'; if not fails=bad
if(~ `{/v10/bin/echo -n abc | wc} '0 1 3') echo PASS 'the real V10 echo: -n'; if not fails=bad
if(~ `{/v10/bin/echo -e 'a\tb' | wc} '1 2 4') echo PASS 'V10 echo -e escapes — the fingerprint Plan 9 echo lacks'; if not fails=bad
if(~ `{/v10/bin/echo tenth edition | cat} 'tenth edition') echo PASS 'V10 and Plan 9 binaries, one pipeline, side by side'; if not fails=bad

if(~ `{echo hello | sed s/hello/goodbye/} goodbye) echo PASS 'real sed rewrites (libregexp at work)'; if not fails=bad
if(~ `{echo a b c | tr a-c A-C} 'A B C') echo PASS 'real tr maps ranges'; if not fails=bad
if(~ `{{echo b; echo a; echo b} | sort | uniq | wc} 2' '*) echo PASS 'real sort | uniq pipeline'; if not fails=bad
if(~ `{ls /bin | grep '^/bin/grep$'} /bin/grep) echo PASS 'real grep, anchored regexp'; if not fails=bad
if(~ `{date | wc} 1' '*) echo PASS 'real date speaks (nsec, ctime)'; if not fails=bad
if(test -f /etc/motd) echo PASS 'real test -f drives rc conditionals'; if not fails=bad
if(test -d /nonexistent) fails=bad; if not echo PASS 'real test -d says no'

# su: identity transition under the ctl rules — never escalation. The
# eve-ruid shell may become anyone (rule 1); su none is the drop shell.
if(~ `{su none id} 'none none') echo PASS 'su none: the privilege-drop shell (rule 1, both ids move)'; if not fails=bad

# sam — the SUCCESSOR holding the ancestor's own tests (the succession
# rule: sam-today inherited /bin/sam by passing these unchanged):
# structural regexps, and the buffer piped through a real command
echo sam test line > /tmp/samf
echo 'e /tmp/samf
,x/test/ c/TEST/
,| tr a-z A-Z
w /tmp/samf
q' > /tmp/samscript
sam -d < /tmp/samscript > /dev/null >[2] /dev/null
if(~ `{cat /tmp/samf} 'SAM TEST LINE') echo PASS 'sam-today holds the ancestor'^''''^'s test: x, c, and | through real tr'; if not fails=bad

# M4, hostfs ('#Z'): a host directory as files — create, write, read back,
# stat length, remove, all against the real disk. Self-skips where the host
# offers no '#Z' (the frozen oracle, the browser).
hz=`{bind '#Z' /n/hz >[2=1]; echo $status}
if(~ $"hz ''){
	echo persist me > /n/hz/m4file
	hzr=`{cat /n/hz/m4file}
	mkdir /n/hz/m4dir
	hzl=`{ls /n/hz/m4dir}
	rm /n/hz/m4file /n/hz/m4dir
	hzg=`{cat /n/hz/m4file >[2=1]}
	if(~ $"hzr 'persist me' && ~ $"hzl '' && ~ $"hzg *'does not exist'* || ~ $"hzg *o such*) echo PASS 'hostfs: a host directory serves create/write/read/remove'; if not fails=bad
}
if not echo PASS 'hostfs: no #Z on this host — skipped'

# The versioning layer ('#V'): a snapshot is a tree, restore is a bind.
# snap freezes the ram root by structural clone (bytes shared, COW on the
# live side's next write); the past reads back verbatim, binds over the
# present, and refuses every write — even eve's. Self-skips where the
# kernel offers no '#V' (the frozen oracle).
vs=`{bind '#V' /n/vs >[2=1]; echo $status}
if(~ $"vs ''){
	echo -n one > /tmp/vfile
	echo snap t1 > /n/vs/ctl
	echo -n two > /tmp/vfile
	vpast=`{cat /n/vs/t1/tmp/vfile}
	vnow=`{cat /tmp/vfile}
	rm /n/vs/t1/tmp/vfile >[2]/dev/null
	vheld=`{cat /n/vs/t1/tmp/vfile}
	mkdir /tmp/rewind
	bind /n/vs/t1/tmp /tmp/rewind
	vrest=`{cat /tmp/rewind/vfile}
	echo del t1 > /n/vs/ctl
	vgone=`{ls /n/vs}
	if(~ $"vpast one && ~ $"vnow two && ~ $"vheld one && ~ $"vrest one && ~ $"vgone *ctl*) echo PASS 'versioning: snap freezes the tree, bind restores it, history refuses writes'; if not fails=bad
}
if not echo PASS 'versioning: no #V on this host — skipped'

# ar(1): the plain GNU archive without the ranlib table — wasm-ld links
# index-less archives (measured, RESEARCH §9.8), so 'ar r' + 'cc -l' is the
# whole static-library story. Round-trip r/t/x/d, replacement included.
arres=`{@{
	cd /tmp
	echo -n alpha > af
	echo -n beta > bf
	ar r t.a af bf
	art=`{ar t t.a}
	echo -n ALPHA > af
	ar r t.a af
	rm af bf
	ar x t.a
	arx=`{cat af bf}
	ar d t.a af
	ard=`{ar t t.a}
	rm t.a af bf
	if(~ $"art 'af bf' && ~ $"arx ALPHAbeta && ~ $"ard bf) echo arok
}}
if(~ $"arres arok) echo PASS 'ar: archives round-trip r/t/x/d, replacement lands'; if not fails=bad

# run(1): a spec directory instantiates a process — M12's local stage.
# The spec declares a namespace (built on the boot file), an environment,
# a credential and a command; run detaches, declares, drops, execs.
mkdir /tmp/s1
cat /lib/namespace > /tmp/s1/namespace
echo 'bind /lib/alt /n/sx' >> /tmp/s1/namespace
echo 'GREETING=hello' > /tmp/s1/env
echo webster > /tmp/s1/user
echo cat > /tmp/s1/cmd
echo /env/GREETING >> /tmp/s1/cmd
echo /dev/user >> /tmp/s1/cmd
echo /n/sx/motd >> /tmp/s1/cmd
rout=`{run /tmp/s1}
if(~ $"rout hellowebsterthe*private*view*motd) echo PASS 'run: a spec instantiates namespace, env, user and cmd'; if not fails=bad

# svc(4): the control plane is a file server — start scales replicas up,
# a killed replica is restarted (reading status reconciles), scale shrinks,
# stop drains and removes. kubectl is cat and echo.
mkdir /tmp/s2
echo sleep > /tmp/s2/cmd
echo 60 >> /tmp/s2/cmd
svc &
svcpid=$apid
sleep 1
mount svc /n/svc
echo start web /tmp/s2 2 > /n/svc/ctl
st1=`{cat /n/svc/web/status}
kill $st1(6)
sleep 1
st2=`{cat /n/svc/web/status}
svok=no
if(~ $"st2 'want 2 have 2'* && ! ~ $"st2 *' '^$st1(6)^' '* && ! ~ $"st2 *' '^$st1(6)) svok=yes
echo scale web 1 > /n/svc/ctl
st3=`{cat /n/svc/web/status}
echo stop web > /n/svc/ctl
st4=`{ls /n/svc}
if(~ $"st1 'want 2 have 2 pids'* && ~ $svok yes && ~ $"st3 'want 1 have 1'* && ~ $"st4 *ctl) echo PASS 'svc: start scales, a killed replica returns, scale shrinks, stop drains'; if not fails=bad
kill $svcpid

# /dev/canvas (M5 v0, docs/canvas.md): the display is a semantic file
# tree — built, edited and driven entirely from rc, which is the point:
# a UI you can cat, echo and grep. The virtual surface is the suite's
# user; resize and close arrive as protocol lines (the old deferral,
# retired). Self-skips where the window server offers no canvas (the
# frozen oracle; the Rust host until parity lands).
cwid=`{cat '#w/clone'}
cvp='#w/'$"cwid^'/canvas'
cvok=`{cat $cvp/caps >[2=1]}
if(~ $"cvok virtual){
	echo new 1 edit > $cvp/ctl
	echo new 2 path > $cvp/ctl
	echo -n 'hello world' > $cvp/1/data
	echo -n '0,5' > $cvp/1/addr
	echo -n HELLO > $cvp/1/data
	echo -n '0,$' > $cvp/1/addr
	cvd=`{cat $cvp/1/data}
	echo 'viewbox="0 0 10 10"' > $cvp/2/attrs
	echo -n 'M0 0 L10 10' > $cvp/2/data
	cvk=`{cat $cvp/2/kind}
	cva=`{grep viewbox $cvp/2/attrs}
	echo sync > $cvp/ctl
	echo 'event execute 1 0 5 HELLO' > $cvp/ctl
	ev1=`{read < $cvp/events}
	echo resize 320 200 > '#w/'$cwid^'/wctl'
	ev2=`{read < $cvp/events}
	ev3=`{{ echo delete > '#w/'$cwid^'/wctl'; read } < $cvp/events}
	if(~ $"cvd 'HELLO world' && ~ $"cvk path && ~ $"cva *viewbox* && ~ $"ev1 'execute 1 0 5 HELLO' && ~ $"ev2 'resize 0 320 200' && ~ $"ev3 'close 0') echo PASS 'canvas: a UI is files — nodes, addr/data edits, attrs, resize/close as events'; if not fails=bad
}
if not echo PASS 'canvas: no /dev/canvas on this host — skipped'

# /dev/window (docs/window.md): the CONTROL interface — IPNX declares the
# chrome, the surface speaks back, and the window's TYPE IS IN THE PATH.
# The whole point is that this is not emca's: any program mints through
# `#w/<type>/clone`, the DEVICE announces it on the root events file, and
# both halves watch. So emca needs no privilege and a window opens with no
# emca running at all — which is what this test actually proves.
# Self-skips where the window server has no control interface (the frozen
# oracle; the JS supervisor until parity lands).
wtid=`{cat '#w/pkg/clone' >[2]/dev/null}
if(! ~ $"wtid ''){
	wp='#w/pkg/'^$wtid
	# the DEVICE announced the mint — nobody had to be told. The root queue
	# is shared, so skip whatever earlier tests left in it.
	wev=''
	while(! ~ $"wev 'new pkg '*) wev=`{read < '#w/events'}
	# IPNX declares the chrome, one control per line, and ACTIONS NAME A SIDE
	echo 'Install ipnx:Install
Wrap host:toggle-wrap' > $wp/toolbar
	# content is a PATH the host opens over 9P — there is no renderer here
	echo -n /pkg/index > $wp/content
	echo -n 'pkg Install Wrap | ' > $wp/tag
	wtb=`{cat $wp/toolbar}
	wct=`{cat $wp/content}
	wtg=`{cat $wp/tag}
	# the type in the path is validated, not decoration: a wrong type misses
	wbad=`{cat '#w/text/'^$wtid^'/content' >[2]/dev/null}
	# and the same window still answers on its plain number — nothing broke
	wnum=`{cat '#w/'^$wtid^'/content'}
	# the surface speaks back; writing events is the virtual surface's door
	echo 'exec Install' > $wp/events
	wu1=`{read < $wp/events}
	wu2=`{{ echo delete > '#w/'$wtid^'/wctl'; read } < '#w/events'}
	if(~ $"wev 'new pkg '^$wtid && ~ $"wtb 'Install ipnx:Install Wrap host:toggle-wrap' && ~ $"wct /pkg/index && ~ $"wtg 'pkg Install Wrap |' && ~ $"wbad '' && ~ $"wnum /pkg/index && ~ $"wu1 'exec Install' && ~ $"wu2 'del '^$wtid) echo PASS '/dev/window: chrome is files — typed path, declared toolbar, lifecycle announced, surface speaks back'
	if not fails=bad
}
if not echo PASS '/dev/window: no control interface on this host — skipped'

# /type (docs/window.md): the registry BOTH HALVES READ. A window type is a
# directory of small files — ns, optional cmd, window, pane — and nothing about
# a type is known to any program: emcaopen reads the registry, the surface reads
# the registry. This is what "adding a manager is adding a file" means, and the
# test is that a manager APPEARS from files alone, with no manager program.
tyok=`{cat /type/proc/pane >[2]/dev/null}
tycw=`{cat '#w/dir/clone' >[2]/dev/null}
if(~ $"tyok left && ! ~ $"tycw ''){
	# the chrome a type declares, and the namespace it constructs
	typw=`{cat /type/proc/window}
	tynn=`{cat /type/proc/ns}
	# opening through the registry: the toolbar is the type's, not the caller's
	tyw=`{rc /rc/emcaopen dir /usr/kitty}
	tytb=`{cat '#w/dir/'^$tyw^'/toolbar'}
	tyct=`{cat '#w/dir/'^$tyw^'/content'}
	# the ns file is APPLIED: proc's bind makes /proc exist for this window
	rc /rc/emcaopen proc /proc >/dev/null >[2=1]
	typroc=`{ls /proc >[2]/dev/null | wc -l}
	# and a type that does not exist is refused, not invented
	tybad=`{rc /rc/emcaopen nosuchtype /x >[2]/dev/null}
	if(~ $"typw 'Kill ipnx:Kill Note ipnx:Note Ns ipnx:Ns' && ~ $"tynn 'bind ''#p'' /proc' && ~ $"tytb 'Look ipnx:Look Get ipnx:Get' && ~ $"tyct /usr/kitty && ! ~ $"typroc 0 && ~ $"tybad '') echo PASS '/type: a manager is files — the registry declares chrome, namespace and placement, and no manager program exists'
	if not fails=bad
}
if not echo PASS '/type: no registry on this host — skipped'

# /proc/<pid> was walkable but not LISTABLE, so a process manager saw an empty
# directory. Fixed in the Rust core; self-skips on the frozen oracle, which
# still answers empty (the floor is what matters, not parity here).
pidls=`{ls /proc/1 >[2]/dev/null}
if(! ~ $"pidls ''){
	if(~ $"pidls '/proc/1/ctl /proc/1/note /proc/1/notepg /proc/1/status') echo PASS '/proc/<pid>: the per-pid directory lists its files, not just walks them'
	if not fails=bad
}
if not echo PASS '/proc/<pid>: not listable on this host — skipped'

# console-today (M5, docs/userland.md): the console is an editable
# transcript — one edit node, a mark separating history from input,
# Enter sends the line. con(1) mediates on the wasm libthread; the test
# drives it through the virtual surface's event door and proves the
# full loop with output the typed text never contained. AND, not XOR:
# the xterm byte console stays beside this one.
cnwid=`{cat '#w/clone' >[2]/dev/null}
if(~ $#cnwid 1){
	cnp='#w/'$"cnwid^'/canvas'
	cnok=`{cat $cnp/caps >[2=1]}
}
if not cnok=absent
if(~ $"cnok virtual){
	con -W $cnwid rc -i &
	sleep 3
	echo -n '0,$' > $cnp/1/addr
	cnoff=`{cat $cnp/1/data | wc -c}
	cnpr=`{cat $cnp/1/data}
	echo 'event insert 1 '$cnoff' echo%20-n%20abc;%20echo%20def%0A' > $cnp/ctl
	sleep 2
	echo -n '0,$' > $cnp/1/addr
	cnt=`{cat $cnp/1/data}
	echo 'event close 0' > $cnp/ctl
	# the round trip is the invariant; the prompt's exact bytes under a
	# pipe are rc's tty-world cosmetics and differ by host
	if(! ~ $"cnoff 0 && ~ $"cnt *abcdef*) echo PASS 'console-today: the transcript is the console — line in, output back through one edit node'; if not fails=bad
}
if not echo PASS 'console-today: no canvas on this host — skipped'

# acme — acme-today under the inherited name (the succession rule:
# the behaviour suite is the proof; the raster ancestor's substrate
# tests stay with acme9). The paper's shape: a root tag over a ROW of
# columns, every tag one EDITABLE node whose WORDS execute (the tag's
# first word is the file name — Put writes to it; Edit takes the rest of
# its line as sam's command). Window 0: wrapper 10, tag 11, body 12;
# column 0's tag is 201; the root tag is 1. Executes carry the word.
if(~ $"cnok virtual){
	echo -n 'first draft' > /tmp/ed1
	edwid=`{cat '#w/clone'}
	edp='#w/'$"edwid^'/canvas'
	acme -W $edwid /tmp/ed1 &
	sleep 2
	echo -n '0,$' > $edp/12/addr
	edb=`{cat $edp/12/data}
	echo 'event insert 12 11 %20revised' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	edf=`{cat /tmp/ed1}
	# Edit takes the scratch after the bar: append the command (99 clamps
	# to the tag's end), execute the word
	echo 'event insert 11 99 %20,x/[a-z]+ised/c/POLISHED/' > $edp/ctl
	echo 'event execute 11 0 0 Edit' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	ede=`{cat /tmp/ed1}
	# the tag is editable everywhere: rename its first word, Put follows
	echo 'event delete 11 0 8' > $edp/ctl
	echo 'event insert 11 0 /tmp/ed2' > $edp/ctl
	echo 'event execute 11 0 0 Put' > $edp/ctl
	sleep 1
	edh=`{cat /tmp/ed2}
	# acme's browser: look resolves against the window's directory —
	# a bare name opens the sibling file; an absolute path opens a
	# LISTING window (names, dirs marked /), Del closes it
	echo 'event look 12 0 0 ed1' > $edp/ctl
	sleep 1
	echo -n '0,$' > $edp/22/addr
	edl=`{cat $edp/22/data}
	echo 'event execute 21 0 0 Del' > $edp/ctl
	echo 'event look 11 0 0 /tmp' > $edp/ctl
	sleep 1
	echo -n '0,$' > $edp/22/addr
	edd=`{cat $edp/22/data}
	echo 'event execute 21 0 0 Del' > $edp/ctl
	# a second column, a window born into it (the active-column rule)
	echo 'event execute 1 0 0 Newcol' > $edp/ctl
	echo 'event execute 211 0 0 New' > $edp/ctl
	sleep 1
	edn=`{cat $edp/21/kind >[2=1]}
	echo 'event execute 11 0 0 Del' > $edp/ctl
	sleep 1
	edg=`{cat $edp/12/kind >[2=1]}
	echo 'event close 0' > $edp/ctl
	if(~ $"edb 'first draft' && ~ $"edf 'first draft revised' && ~ $"ede 'first draft POLISHED' && ~ $"edh 'first draft POLISHED' && ~ $"edl 'first draft POLISHED' && ~ $"edd *ed1* && ~ $"edd *ed2* && ~ $"edn edit && ~ $"edg *'does not exist'* || ~ $"edg *o such*) echo PASS 'acme: the heir holds the behaviour suite — columns, editable tags, words execute, look is the browser'; if not fails=bad
}
if not echo PASS 'acme: no canvas on this host — skipped'

# acme against the paper (the fidelity pass, 2026-08-30): external
# commands run in the window's directory, output to dir/+Errors; the
# selection filters | < > work; Undo/Redo unwind by sequence; the tag
# grows Undo/Put dynamically (the paper's rule); B3 takes addresses
# (file:2); Cut/Snarf/Paste are words AND /dev/snarf; Sort orders a
# column; and the file interface serves index, new and
# N/{tag,body,addr,data,ctl,event} at /srv/acme. Window k: 9P dir
# 10+10k, canvas tag 11+10k, body 12+10k.
if(~ $"cnok virtual){
	mkdir /tmp/aw
	echo -n 'alpha beta' > /tmp/aw/f1
	echo one > /tmp/aw/f3
	echo two words here >> /tmp/aw/f3
	echo three >> /tmp/aw/f3
	apwid=`{cat '#w/clone'}
	app='#w/'$"apwid^'/canvas'
	acme -W $apwid /tmp/aw/f1 &
	sleep 2
	# external commands: output lands in /tmp/aw/+Errors (window 1)
	echo 'event execute 11 0 0 echo%20paper%20works' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/22/addr
	er1=`{cat $app/22/data}
	# directory context: a relative name resolves in the window's dir
	echo 'event execute 11 0 0 cat%20f1' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/22/addr
	er2=`{cat $app/22/data}
	# | filters the selection through a command
	echo 'event select 12 0 5' > $app/ctl
	echo 'event execute 11 0 0 |tr%20a-z%20A-Z' > $app/ctl
	sleep 2
	echo -n '0,$' > $app/12/addr
	ab1=`{cat $app/12/data}
	# Undo unwinds it, Redo restores it, the tag says so
	echo 'event execute 11 0 0 Undo' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	ab2=`{cat $app/12/data}
	echo 'event execute 11 0 0 Redo' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	ab3=`{cat $app/12/data}
	echo -n '0,$' > $app/11/addr
	tg1=`{cat $app/11/data}
	# Snarf/Cut/Paste as words, through /dev/snarf itself
	echo 'event select 12 0 5' > $app/ctl
	echo 'event execute 11 0 0 Snarf' > $app/ctl
	sleep 1
	sn=`{cat '#w/snarf'}
	echo 'event execute 11 0 0 Cut' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	cb1=`{cat $app/12/data}
	echo 'event execute 11 0 0 Paste' > $app/ctl
	sleep 1
	echo -n '0,$' > $app/12/addr
	pa1=`{cat $app/12/data}
	# B3 with an address: f3:2 opens the file AT line two (sel travels)
	echo 'event look 12 0 0 f3:2' > $app/ctl
	sleep 1
	a32=`{grep sel $app/32/attrs}
	# the file interface: index, addressed edits, new/, the event file
	mkdir /mnt/acme
	mount acme /mnt/acme
	ix=`{grep -c f1 /mnt/acme/index}
	echo -n 2 > /mnt/acme/30/addr
	echo -n 'TWO WORDS' > /mnt/acme/30/data
	sleep 1
	echo -n '0,$' > $app/32/addr
	w3=`{cat $app/32/data}
	echo hello new > /mnt/acme/new/body
	sleep 1
	echo -n '0,$' > $app/42/addr
	nb=`{cat $app/42/data}
	read < /mnt/acme/10/event > /tmp/aw/ev &
	sleep 1
	echo 'event execute 11 0 0 Put' > $app/ctl
	sleep 2
	ev=`{cat /tmp/aw/ev}
	echo 'event execute 11 0 0 Put' > $app/ctl
	sleep 1
	pf=`{cat /tmp/aw/f1}
	# Sort orders the column's windows by name
	echo 'event execute 201 0 0 Sort' > $app/ctl
	sleep 1
	so1=`{grep order $app/10/attrs}
	unmount /mnt/acme >[2] /dev/null
	echo 'event close 0' > $app/ctl
	apok=yes
	if(! ~ $"er1 'paper works') apok=no
	if(! ~ $"er2 *'alpha beta'*) apok=no
	if(! ~ $"ab1 'ALPHA beta' || ! ~ $"ab2 'alpha beta' || ! ~ $"ab3 'ALPHA beta') apok=no
	if(! ~ $"tg1 *Undo* || ! ~ $"tg1 *Put*) apok=no
	if(! ~ $"sn ALPHA || ! ~ $"cb1 beta || ! ~ $"pa1 'ALPHA beta') apok=no
	if(! ~ $"a32 'sel=4,19') apok=no
	if(~ $ix 0) apok=no
	if(! ~ $"w3 *'TWO WORDS'*) apok=no
	if(! ~ $"nb 'hello new') apok=no
	if(! ~ $"ev 'Mx0 0 0 3 Put') apok=no
	if(! ~ $"pf 'ALPHA beta') apok=no
	if(! ~ $"so1 'order=3') apok=no
	if(~ $apok yes) echo PASS 'acme against the paper: +Errors, the | filter, Undo/Redo, dynamic Put, look addresses, Cut/Snarf/Paste, Sort, and the served file interface'; if not fails=bad
}
if not echo PASS 'acme paper pass: no canvas on this host — skipped'

# rio-today's proof: a window manager in rc. ls '#w' lists the windows;
# /rc/tile writes move and resize lines to every wctl — policy is a file
# you write, so any program can be a window manager, this script included.
# Self-skips where '#w' has no root listing (the frozen oracle).
twl=`{ls '#w' >[2]/dev/null}
if(! ~ $#twl 0){
	tw1=`{cat '#w/clone'}
	tw2=`{cat '#w/clone'}
	rc /rc/tile
	tg1=`{cat '#w/'$tw1^'/wctl'}
	tg2=`{cat '#w/'$tw2^'/wctl'}
	if(~ $tg1(2) 60 && ~ $tg2(2) 60 && ~ $tg1(3) 300 && ~ $tg2(3) 300 && ! ~ $tg1(1) $tg2(1)) echo PASS 'rio-today: a window manager in rc — tile moved every window by writing wctl'; if not fails=bad
	echo delete > '#w/'$tw1^'/wctl'
	echo delete > '#w/'$tw2^'/wctl'
}
if not echo PASS 'rio-today: no #w listing on this host — skipped'

# /dev/snarf: the clipboard is a file (the input convention's own words —
# chords die into the host clipboard via /dev/snarf). On macOS it IS the
# pasteboard (pbcopy/pbpaste); elsewhere the kernel buffer serves. The
# gesture mirror (cmd-C/X/V feeding this file) is the presenter's half.
# Self-skips where '#w' has no snarf (the frozen oracle).
snp=`{cat '#w/snarf' >[2=1]}
if(! ~ $"snp *'does not exist'* && ! ~ $"snp *'bad path'*){
	echo -n 'snarf travels' > '#w/snarf'
	snr=`{cat '#w/snarf'}
	if(~ $"snr 'snarf travels') echo PASS 'snarf: the clipboard is a file — write it, read it back'; if not fails=bad
}
if not echo PASS 'snarf: no /dev/snarf on this host — skipped'

# M2, the namespace-file boot: the same file format that boots the system
# reshapes a world at runtime — newns(file, cmd) clears and rebuilds from
# TEXT, so editing the file rebinds with no recompile (the acceptance).
echo 'bind /lib/alt /etc' > /tmp/ns1
nsa=`{newns /tmp/ns1 cat /etc/motd}
echo 'cd /lib' >> /tmp/ns1
nsb=`{newns /tmp/ns1 pwd}
if(~ $"nsa *'private view'* && ~ $nsb /lib) echo PASS 'newns: a namespace built from a file; an edit rebinds, no recompile'; if not fails=bad

# pkg(1): the whole life of a package against an offline local registry —
# a registry is just a tree of files, so the suite authors one, installs
# from it (streamed, sha256-verified), runs the bound binary through the
# /bin union, verifies digests, and removes. Network never involved.
mkdir /tmp/reg
cp /bin/echo /tmp/reg/pecho.wasm
pd=`{sha256sum < /tmp/reg/pecho.wasm}
echo pecho 1.0 bin /tmp/reg/pecho.wasm $pd > /tmp/reg/index
pkg -r /tmp/reg install pecho > /dev/null
pkv=`{pkg verify pecho}
pkr=`{pecho pkg bound and running}
pkg remove pecho > /dev/null
if(~ $pkr 'pkg bound and running' && ~ $"pkv *clean*) echo PASS 'pkg: install from a registry tree, sha256-verified, bind, verify, remove'; if not fails=bad

# the namespace dissolves package conflicts (design 2026-08-29): a name that
# already resolves to DIFFERENT bytes refuses the install; nothing global to
# corrupt, nothing silently shadowed by accident
mkdir /tmp/reg2
cp /bin/cat /tmp/reg2/echo.wasm
cd2=`{sha256sum < /tmp/reg2/echo.wasm}
echo echo 9.9 bin /tmp/reg2/echo.wasm $cd2 > /tmp/reg2/index
pkc=`{pkg -r /tmp/reg2 install echo >[2=1]}
if(~ $"pkc *CONFLICT* && ~ `{pkg list} '') echo PASS 'pkg: same name, different bytes — the install is refused'; if not fails=bad

# dev environments are processes (design 2026-08-29): an rfork n subshell
# installs its own package; the parent never sees it — venv with no venv
penv=`{rc -c 'rfork n; pkg -r /tmp/reg install pecho > /dev/null; pecho env-private'}
pgone=`{pecho after >[2=1]}
if(~ $penv 'env-private' && ~ $"pgone *'does not exist'*) echo PASS 'pkg in rfork n: a private dev environment, gone with the process'; if not fails=bad

# regexp CLASSES WITH RANGES in x: the class-range sentinel is Runemax
# stored in a Rune (sam/regexp.c bldcclass), so this is the one structural
# pattern that catches a Rune narrower than libc.h's 21-bit era — a 16-bit
# Rune truncates the sentinel and every [a-z] silently stops matching
# (measured 2026-08-29; fixed by u.h's 32-bit Rune, RESEARCH §9.4)
echo 'horses for courses' > /tmp/samr
echo 'e /tmp/samr
,x/[a-z]+es/ g/co/ c/COURSES/
w /tmp/samr
q' > /tmp/samrscript
sam -d < /tmp/samrscript > /dev/null >[2] /dev/null
if(~ `{cat /tmp/samr} 'horses for COURSES') echo PASS 'sam x with class ranges: ,x/[a-z]+es/ g// c// lands'; if not fails=bad

# real-rc capabilities the mini shell refused outright
fn twice {echo $1 $1}
if(~ `{twice hey} 'hey hey') echo PASS 'fn: functions define and take arguments'; if not fails=bad
n=()
while(! ~ $#n 3) n=($n x)
if(~ $#n 3) echo PASS 'while: loops until the condition holds'; if not fails=bad
switch(two){
case one
	fails=bad
case two
	echo PASS 'switch/case selects the matching arm'
case *
	fails=bad
}

# the tour (the public demo's guided walk) runs non-interactively and
# self-skips if the rootfs lacks it — one rootfs serves every host
if(test -f /rc/tour){
	rc /rc/tour > /tmp/tour.out >[2] /dev/null
	if(~ `{grep -c '^tour: complete' /tmp/tour.out} 1 && ~ `{grep -c '^result: horses for COURSES' /tmp/tour.out} 1) echo PASS 'the tour runs end to end, sam edit verified (rc /rc/tour)'; if not fails=bad
}

if(~ $fails ok) echo rc: tests done
if not echo rc: TESTS FAILED
if(~ $fails ok) exit ''
exit failed
