# /lib/namespace — the canonical boot namespace (namespace(6) subset, M2).
# Read by init through newns(); the root is implicit — an empty namespace
# resolves absolute paths through the ramfs (#R). This file format is also
# the profile's namespace-fragment format (identity.md), stage one.
bind #c /dev
bind #e /env
bind #d /fd
bind #s /srv
bind #p /proc
# the control interface lives at a path, not at a device letter
# (docs/window.md): #w/<type>/<n> is reached as /dev/window/<type>/<n>.
bind #w /dev/window
