# /profile/start.ns — the system's namespace, in `namespace(6)`'s format:
# the first of the system's start.ns, start.env, start.rc (docs/packages.md).
# It was /lib/namespace, as Plan 9 keeps it: `plan9/lib/namespace`, read by
# `newns()` which init calls. Every line is a bind, a mount, a cd or a `.` — and the file is the
# reason a boot is configuration rather than code.
#
# The lines boot has already run are here too, because `newns` starts from an
# EMPTY namespace: `rfork(RFCNAMEG)` clears it and this file rebuilds it. That
# is why the root is mounted from `#s/boot` — boot posted it there precisely
# so it could be mounted again without knowing where it came from.

# root
mount -aC #s/boot /root
bind -a /root /
bind -c /root/mnt /mnt

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv
bind -a #¤ /dev

# standard bin (`plan9/lib/namespace`: `bind /$cputype/bin /bin`) — here the
# programs are the `system` package's (docs/packages.md), installed to the
# system, so its binds are these. Plan 9's next line, `bind -a /rc/bin /bin`,
# went with /rc. rc's startup file is the package's too, at /lib/rcmain.
bind /pkg/system/2026.09.24/$objtype/bin /bin
bind -a /pkg/system/2026.09.24/lib /lib

# the user's home: /home is /usr/$user (docs/packages.md), where the user's
# profile is, at /home/profile
bind -c /usr/$user /home
