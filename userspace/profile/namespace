# /profile/namespace — the system's namespace bindings, part of its
# configuration (docs/packages.md, "A profile"). It was /lib/namespace, as
# Plan 9 keeps it: `plan9/lib/namespace`, read by `newns()` which init
# calls. Every line is a bind, a mount, a cd or a `.` — and the file is the
# reason a boot is configuration rather than code.
#
# The lines boot has already run are here too, because `newns` starts from an
# EMPTY namespace: `rfork(RFCNAMEG)` clears it and this file rebuilds it. That
# is why the root is mounted from `#s/boot` — boot posted it there precisely
# so it could be mounted again without knowing where it came from.

# root
mount -aC #s/boot /root
bind -a /root /

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv
bind -a #¤ /dev

# standard bin (`plan9/lib/namespace`: `bind /$cputype/bin /bin`). Plan 9's
# next line, `bind -a /rc/bin /bin`, is gone with /rc: rc scripts are
# programs, and programs come in packages.
bind /$objtype/bin /bin

# the user's home: /home is /usr/$user (docs/packages.md), where the user's
# profile is, at /home/profile
bind -c /usr/$user /home
