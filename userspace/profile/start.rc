#!/bin/rc
# /profile/start.rc — run once, when the system boots (docs/packages.md). It
# was /rc/bin/termrc: `plan9/rc/bin/termrc`, cut to what this system has.
#
# Plan 9's binds the devices it did not bind at boot, reads the partition
# tables, starts swap, cs, dns and timesync, and sources /cfg/$sysname/termrc.
# None of those exist here yet. What is left is what termrc is FOR: the
# devices a terminal wants, bound by the system rather than by the embedding.

# bind all likely devices (`termrc:12`), Plan 9's list as it is: a letter
# this kernel does not have fails, silently, as it does on a terminal
# without that hardware. `#t` is the serial line the surface is on.
for(i in f t m v L P u U '$' Σ κ)
	/bin/bind -a '#'^$i /dev >/dev/null >[2=1]

# a name (`termrc:31`, with `ndb/cs` left out — there is no network to get a
# name from, so the default is all there is)
sysname=`{cat /dev/sysname}
if (~ $#sysname 0 || ~ $sysname '') {
	sysname = gnot			# default
	echo -n $sysname >/dev/sysname
}

# parallelism for mk (`termrc:8`): one line of /dev/sysstat a processor
NPROC = `{wc -l /dev/sysstat}

# the system's services (docs/packages.md): each named in /profile/service
# without Plan 9's leading `!`, as `cpurc` starts the daemons it lists
if(test -r /profile/service)
	for(s in `{sed '/^[!#]/d' /profile/service})
		service start -s $s
